    p.add_argument("slug")
    p.add_argument("--api")
    p.add_argument("--app")
    p.add_argument("--out")
    p.add_argument("--force", action="store_true")
    p = add("diff", cmd_diff, "pixel diff before/after and UI tree diff")
    p.add_argument("--run")
    p.add_argument("--all", action="store_true", help="also show unchanged pairs")
    p.add_argument("--limit", type=int, default=30)
    p.add_argument("--mask-top", type=float, default=0.04, help="share of the height compared apart as the status bar")
    p.add_argument("--full", action="store_true", help="diff images in full size (default: 540 px wide)")
    p = add("record", cmd_record, "screenrecord video and a contact sheet", "one")
    p.add_argument("name")
    p.add_argument("--seconds", type=int, default=6)
    p.add_argument("--slow", type=float, help="animation scale during recording")
    p.add_argument("--frames", type=int, default=12)
    p.add_argument("--as", dest="as_", choices=VERSIONS)
    p.epilog = "After -- you can pass a command to run during recording: adbm record x --api 35 -- adbm tap --api 35 OK"
    p = add("board", cmd_board, "HTML board and PNG contact sheet of a run")
    p.add_argument("--run")
    p.add_argument("--out", help="where to write the board (default: the run folder)")
    p.add_argument("--open", action="store_true")
    p.add_argument("--summary-max", type=int, default=24)
    p.add_argument("--all", action="store_true", help="contact sheet with unchanged pairs too")

    argv = sys.argv[1:]
    tail = []
    if argv and argv[0] == "record" and "--" in argv:
        i = argv.index("--")
        argv, tail = argv[:i], argv[i + 1:]
    a = P.parse_args(argv)
    a.during = tail
    out, err = CountingStream(sys.stdout), CountingStream(sys.stderr)
    sys.stdout, sys.stderr = out, err
    try:
        sys.exit(a.fn(a) or 0)
    except KeyboardInterrupt:
        sys.exit(130)
    finally:
        sys.stdout, sys.stderr = out.stream, err.stream
        record_context(a, out.n + err.n)


if __name__ == "__main__":
    main()
