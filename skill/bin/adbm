#!/usr/bin/env python3
"""adbm — Android Debug Bridge Matrix.

CLI for checking Android apps as an agent: emulators are addressed by API level,
Maestro runs the flows, frames are sorted into run folders,
the result is an HTML board and a "before | after" PNG contact sheet. Images do not
enter the agent's context: navigation goes by the UI tree text.

Requirements: Python 3.9+, Pillow (contact sheet, diff, look), adb.
Maestro for flows. ffmpeg for record.
"""
import argparse
import concurrent.futures as cf
import configparser
import contextlib
import datetime as dt
import fcntl
import functools
import glob
import hashlib
import json
import os
import platform
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import xml.etree.ElementTree as ET

VERSION = "0.2.1"
HERE = os.path.dirname(os.path.realpath(__file__))
SKILL_DIR = os.path.dirname(HERE)
VIEWER = os.path.join(SKILL_DIR, "viewer", "index.html")
CACHE = os.path.expanduser(os.environ.get("ADBM_CACHE", "~/.cache/adbm"))
VERSIONS = ("before", "after")
TUNE = {
    "hw.ramSize": "4096",
    "vm.heapSize": "576",
    "hw.cores": "4",
    "disk.dataPartition.size": "8G",
    "hw.keyboard": "yes",
    "hw.gpu.mode": "host",
}
# system image variants for a phone AVD, in order of preference
PHONE_IMAGES = ("google_apis", "google_apis_playstore", "default", "google_atd", "aosp_atd")
LOOK_W = {"normal": 540, "small": 360}
DIFF_W = 540
# a full 1080×2400 screenshot in the context: what `ui`, `tap` and `look` replace (adbm status, saved)
SCREEN_TOKENS = -(-1080 // 28) * -(-2400 // 28)
SCREEN_COMMANDS = ("ui", "tap")
_lock = threading.Lock()
USED_RUN = []  # the run folder a command worked with: its output size goes to that run's stats.json


# ---------------------------------------------------------------- utilities

def pkg_hint(brew, apt):
    """Install command for this OS: Homebrew on macOS, apt elsewhere."""
    return f"brew install {brew}" if sys.platform == "darwin" else f"sudo apt install {apt} (or your distro's package)"


PILLOW_HINT = ("pip install Pillow for the python3 that runs adbm (Homebrew: brew install pillow; "
               "Debian/Ubuntu: sudo apt install python3-pil; or a venv)")


def android_cli():
    """Path to Google's Android CLI; the old SDK `tools/android` script with the same name does not count."""
    p = shutil.which("android")
    if not p:
        return None
    d = os.path.dirname(os.path.realpath(p))
    if os.path.basename(d) == "tools" and os.path.isdir(os.path.join(os.path.dirname(d), "platform-tools")):
        return None
    return p


def maestro_bin():
    """Maestro on PATH, or in ~/.maestro/bin where its install script puts it."""
    p = os.path.expanduser("~/.maestro/bin/maestro")
    return shutil.which("maestro") or (p if os.access(p, os.X_OK) else None)


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def sh(cmd, timeout=120, check=False, binary=False, env=None):
    """Run a command. Returns (code, stdout, stderr)."""
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=timeout, env=env)
    except FileNotFoundError:
        return 127, b"" if binary else "", f"not found: {cmd[0]}"
    except subprocess.TimeoutExpired:
        return 124, b"" if binary else "", f"timeout {timeout} s: {' '.join(cmd)}"
    out = p.stdout if binary else p.stdout.decode("utf-8", "replace")
    err = p.stderr.decode("utf-8", "replace")
    if check and p.returncode != 0:
        die(f"{' '.join(cmd)}: {err.strip() or out}")
    return p.returncode, out, err


def sdk_root():
    for k in ("ANDROID_HOME", "ANDROID_SDK_ROOT"):
        v = os.environ.get(k)
        if v:
            return v
    for p in ("~/Library/Android/sdk", "~/Android/Sdk"):
        p = os.path.expanduser(p)
        if os.path.isdir(p):
            return p
    return None


def sdk_tool(rel, name):
    """A tool from the SDK, then from PATH."""
    root = sdk_root()
    if root:
        p = os.path.join(root, rel, name)
        if os.path.exists(p):
            return p
    return shutil.which(name)


def adb_bin():
    p = sdk_tool("platform-tools", "adb")
    if not p:
        die("adb not found — run `adbm doctor`")
    return p


def adb(serial, *args, timeout=60, binary=False):
    return sh([adb_bin(), "-s", serial, *args], timeout=timeout, binary=binary)


def ashell(serial, cmd, timeout=60):
    return adb(serial, "shell", cmd, timeout=timeout)[1].strip()


def parse_apis(s):
    if s is None:
        return None
    out = []
    for part in str(s).split(","):
        part = part.strip()
        if part:
            if not part.isdigit():
                die(f"API must be a number: {part}")
            if int(part) not in out:
                out.append(int(part))
    return out


@functools.lru_cache(maxsize=None)
def project_root():
    if os.environ.get("ADBM_PROJECT"):
        return os.environ["ADBM_PROJECT"]
    code, out, _ = sh(["git", "rev-parse", "--show-toplevel"], timeout=10)
    return out.strip() if code == 0 and out.strip() else os.getcwd()


def runs_dir():
    return os.path.join(project_root(), "build", "adbm")


def slugify(s):
    s = re.sub(r"[^\w\-]+", "-", s.strip().lower(), flags=re.U).strip("-")
    return s[:40] or "run"


def rel(p):
    try:
        r = os.path.relpath(p)
        return r if not r.startswith("../..") else p
    except ValueError:
        return p


def human_size(n):
    for u in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {u}"
        n /= 1024
    return f"{n:.1f} TB"


# ---------------------------------------------------------------- run dir

def current_run(create=True, slug="manual", new=False, mark=True):
    base = runs_dir()
    cur = os.path.join(base, ".current")
    if not new and os.path.exists(cur):
        name = open(cur).read().strip()
        p = os.path.join(base, name)
        if name and os.path.isdir(p):
            if mark:
                USED_RUN[:] = [p]
            return p
    if not create:
        return None
    return new_run(slug)


def new_run(slug):
    base = runs_dir()
    prev = current_run(create=False) or project_cache()
    name = dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + slugify(slug)
    p = os.path.join(base, name)
    os.makedirs(os.path.join(p, "logs"), exist_ok=True)
    # what is installed on the devices does not change with a new run folder
    for f in (".as", "builds.json"):
        if os.path.exists(os.path.join(prev, f)):
            shutil.copy(os.path.join(prev, f), os.path.join(p, f))
    with open(os.path.join(base, ".current"), "w") as f:
        f.write(name)
    USED_RUN[:] = [p]
    gi = os.path.join(base, ".gitignore")
    if not os.path.exists(gi):
        with open(gi, "w") as f:
            f.write("*\n")
    return p


def project_cache():
    """Per-project cache: what is installed for this project when no run exists yet."""
    p = os.path.join(CACHE, "projects", hashlib.sha1(project_root().encode()).hexdigest()[:12])
    os.makedirs(p, exist_ok=True)
    return p


def scratch():
    """Folder for service files: the current run, outside a run the cache, so no build/adbm in the project."""
    p = current_run(create=False, mark=False) or CACHE
    os.makedirs(os.path.join(p, "logs"), exist_ok=True)
    return p


def resolve_run(arg, create=True, slug="manual"):
    if arg:
        p = arg if os.path.isabs(arg) or os.path.exists(arg) else os.path.join(runs_dir(), arg)
        if not os.path.isdir(p):
            die(f"no run folder: {arg}")
        USED_RUN[:] = [os.path.abspath(p)]
        return os.path.abspath(p)
    return current_run(create=create, slug=slug)


@contextlib.contextmanager
def file_lock(path):
    """Lock between adbm processes: a background `adbm run` and `adbm ui` write one stats.json."""
    with _lock, open(path + ".lock", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def stats_add(run, _set=None, **inc):
    """Add numbers to stats.json, merge dicts; _set — values that replace the old ones."""
    p = os.path.join(run, "stats.json")
    with file_lock(p):
        try:
            st = json.load(open(p))
        except Exception:
            st = {}
        for k, v in inc.items():
            if isinstance(v, (int, float)):
                st[k] = st.get(k, 0) + v
            elif isinstance(v, dict):
                sub = st.setdefault(k, {})
                for kk, vv in v.items():
                    sub[kk] = sub.get(kk, 0) + vv
            else:
                st[k] = v
        st.update(_set or {})
        tmp = p + f".{os.getpid()}.tmp"
        json.dump(st, open(tmp, "w"), ensure_ascii=False, indent=1)
        os.replace(tmp, p)


class CountingStream:
    """A stdout/stderr wrapper that counts the characters written: what the agent reads."""

    def __init__(self, stream):
        self.stream, self.n = stream, 0

    def write(self, text):
        self.n += len(text)
        return self.stream.write(text)

    def __getattr__(self, name):
        return getattr(self.stream, name)


def record_context(a, chars):
    """Add a command's output size to stats.json of the run it worked with; never fails the command.

    A command started by `adbm record … -- <command>` writes to a log, not to the agent: not counted.
    Without a fresh run the output goes to the project cache: `adbm status --project` shows it as "outside runs".
    """
    if os.environ.get("ADBM_NO_STATS"):
        return
    try:
        run = USED_RUN[0] if USED_RUN else fresh_run() or project_cache()
        if run and os.path.isdir(run):
            stats_add(run, context_chars=chars, commands=1, chars_by_command={a.cmd: chars},
                      calls_by_command={a.cmd: 1})
    except Exception:
        pass


def fresh_run(hours=12):
    """The current run if it was active less than `hours` ago: navigation between frames belongs to it."""
    run = current_run(create=False, mark=False)
    if not run:
        return None
    last = max((os.path.getmtime(os.path.join(run, f)) for f in ("stats.json", ".")
                if os.path.exists(os.path.join(run, f))), default=0)
    return run if time.time() - last < hours * 3600 else None


def session_log(entry):
    """Journal of manual actions — the source for save-flow."""
    os.makedirs(CACHE, exist_ok=True)
    entry = {"t": time.time(), "project": project_root(), **entry}
    with _lock, open(os.path.join(CACHE, "session.jsonl"), "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def pil():
    try:
        from PIL import Image
    except ImportError:
        die("Pillow is missing — " + PILLOW_HINT)
    return Image


# ---------------------------------------------------------------- devices

def avd_home():
    if os.environ.get("ANDROID_AVD_HOME"):
        return os.environ["ANDROID_AVD_HOME"]
    user = os.environ.get("ANDROID_USER_HOME") or os.environ.get("ANDROID_EMULATOR_HOME")
    return os.path.join(user, "avd") if user else os.path.expanduser("~/.android/avd")


NOT_PHONE = re.compile(r"wear|android-tv|google-tv|automotive|android-desktop|tablet|fold|\btv_", re.I)


def phone_avds(avds, api):
    """Phone AVDs of an API level: adbm's own first, then by name; Wear, TV, Automotive, tablets skipped."""
    names = [n for n, i in avds.items() if i["api"] == api and (n == f"adbm_API_{api}" or not NOT_PHONE.search(
        " ".join(i["config"].get(k, "") for k in ("image.sysdir.1", "tag.id", "hw.device.name"))))]
    return sorted(names, key=lambda n: (n != f"adbm_API_{api}", n.lower()))


def avd_index():
    """AVD → {api, path, config}."""
    home = avd_home()
    res = {}
    for ini in sorted(glob.glob(os.path.join(home, "*.ini"))):
        name = os.path.basename(ini)[:-4]
        path = None
        for line in open(ini, errors="replace"):
            if line.startswith("path="):
                path = line.split("=", 1)[1].strip()
        path = path or os.path.join(home, name + ".avd")
        cfg = read_ini(os.path.join(path, "config.ini"))
        sysdir = cfg.get("image.sysdir.1", "")
        m = re.search(r"android-(\d+)", sysdir)
        res[name] = {"api": int(m.group(1)) if m else None, "path": path, "config": cfg}
    return res


def read_ini(p):
    cfg = {}
    if os.path.exists(p):
        for line in open(p, errors="replace"):
            if "=" in line:
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip()
    return cfg


BAD_STATES = {
    "offline": "adb reconnect, or adb kill-server; an emulator — adbm devices --stop N, then --start N",
    "unauthorized": "accept the USB debugging prompt on the device, then adb kill-server && adb start-server",
    "no permissions": "the USB device needs a udev rule (Linux)",
}


def state_hint(st):
    """A hint for an adb device state such as 'offline' or 'no permissions (user … plugdev …)'."""
    return BAD_STATES.get(st.split(" (")[0].split(":")[0].strip(), "see reference/adb.md")


def adb_states():
    """{serial: state} from `adb devices`, all states."""
    _, out, _ = sh([adb_bin(), "devices"], timeout=15)
    res = {}
    for line in out.splitlines()[1:]:
        parts = line.split(None, 1)
        if len(parts) == 2:
            res[parts[0]] = parts[1].strip()
    return res


def list_devices():
    """Connected devices in the device state."""
    serials = [s for s, st in adb_states().items() if st == "device"]

    def info(s):
        api = ashell(s, "getprop ro.build.version.sdk", timeout=15)
        d = {"serial": s, "api": int(api) if api.isdigit() else None,
             "emulator": s.startswith("emulator-")}
        if d["emulator"]:
            _, o, _ = adb(s, "emu", "avd", "name", timeout=10)
            d["name"] = (o.splitlines() or ["?"])[0].strip()
        else:
            d["name"] = ashell(s, "getprop ro.product.model", timeout=10)
        return d

    with cf.ThreadPoolExecutor(8) as ex:
        return sorted(ex.map(info, serials), key=lambda d: (not d["emulator"], d["api"] or 0))


def pick(args, multi=False):
    """Returns [(api, serial)] for --api / --serial."""
    if getattr(args, "serial", None):
        api = ashell(args.serial, "getprop ro.build.version.sdk", timeout=15)
        return [(int(api) if api.isdigit() else 0, args.serial)]
    devs = list_devices()
    if not devs:
        bad = {s: st for s, st in adb_states().items() if st != "device"}
        die("no devices connected — `adbm devices --start <API>`" +
            "".join(f"\n{s}: {st} — {state_hint(st)}" for s, st in bad.items()))
    apis = parse_apis(getattr(args, "api", None))
    if not apis and multi:
        apis = config_apis()
    if not apis:
        emus = [d for d in devs if d["emulator"]]
        if len(emus) == 1:
            return [(emus[0]["api"], emus[0]["serial"])]
        if not emus and len(devs) == 1:
            return [(devs[0]["api"], devs[0]["serial"])]
        running = [a_ for a_ in sorted(config_apis(), reverse=True) + [35]
                   if any(d["api"] == a_ and d["emulator"] for d in devs)]
        if running:
            apis = running[:1]
        else:
            die("pass --api: running " + ", ".join(f"{d['api']}" for d in devs)
                + ("" if config_apis() else "\nthe project's API levels are not set: ask the person, then"
                   " adbm config --set devices.apis=28,33,35 --project"))
    res = []
    for a in apis:
        cand = [d for d in devs if d["api"] == a]
        cand.sort(key=lambda d: not d["emulator"])
        if not cand:
            die(f"no device with API {a} — `adbm devices --start {a}`")
        res.append((a, cand[0]["serial"]))
    if not multi and len(res) > 1:
        die("this command works with one device — pass a single --api")
    return res


def parallel(targets, fn):
    """fn(api, serial) on all devices in parallel, results in the order of targets."""
    if len(targets) == 1:
        return [fn(*targets[0])]
    with cf.ThreadPoolExecutor(len(targets)) as ex:
        return list(ex.map(lambda t: fn(*t), targets))


def screen_size(serial):
    out = ashell(serial, "wm size")
    m = re.findall(r"(\d+)x(\d+)", out)
    return tuple(map(int, m[-1])) if m else (0, 0)


def frame_problem(path, check_black=True):
    """Empty or non-PNG file → 'broken', black content area → 'black', else None.

    The broken check needs no Pillow. A FLAG_SECURE window gives an exactly uniform black
    content area (system bars may still be drawn), so the black check looks only at the
    middle of the frame and wants it nearly constant — a dark theme with any text passes.
    """
    try:
        with open(path, "rb") as f:
            if f.read(8) != b"\x89PNG\r\n\x1a\n":
                return "broken"
    except OSError:
        return "broken"
    if not check_black:
        return None
    try:
        from PIL import Image
        with Image.open(path) as im:
            w, h = im.size
            lo, hi = im.convert("L").crop((0, int(h * .08), w, int(h * .88))).getextrema()
        return "black" if hi <= 8 else None
    except ImportError:
        return None
    except Exception:
        return "broken"


SECURE_HINT = "black frame — probably a window with FLAG_SECURE (screenshot protection): turn it off in the app"


def screencap(serial):
    code, data, err = adb(serial, "exec-out", "screencap", "-p", timeout=30, binary=True)
    if code != 0 or not data.startswith(b"\x89PNG"):
        die(f"[{serial}] screencap failed: {err.strip()}")
    return data


# ---------------------------------------------------------------- UI tree

BOUNDS = re.compile(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]")


def dump_xml(serial, tries=3):
    last = ""
    for i in range(tries):
        code, out, err = adb(serial, "exec-out",
                             "rm -f /sdcard/adbm-ui.xml; uiautomator dump /sdcard/adbm-ui.xml >/dev/null 2>&1 && cat /sdcard/adbm-ui.xml",
                             timeout=40)
        if "<hierarchy" in out:
            return out[out.index("<?xml") if "<?xml" in out else out.index("<hierarchy"):]
        last = (out + err).strip()[:200]
        time.sleep(1)
    die(f"[{serial}] uiautomator dump failed: {last}")


def parse_nodes(xml, include_system=False):
    root = ET.fromstring(xml.encode("utf-8"))
    nodes = []
    for n in root.iter("node"):
        a = n.attrib
        m = BOUNDS.match(a.get("bounds", ""))
        if not m:
            continue
        x0, y0, x1, y1 = map(int, m.groups())
        if x1 <= x0 or y1 <= y0:
            continue
        if not include_system and a.get("package") == "com.android.systemui":
            continue
        text = a.get("text", "")
        desc = a.get("content-desc", "")
        rid = a.get("resource-id", "")
        flags = [f for f, k in (("click", "clickable"), ("scroll", "scrollable"), ("check", "checkable"),
                                ("on", "checked"), ("focus", "focused"), ("sel", "selected"),
                                ("long", "long-clickable")) if a.get(k) == "true"]
        if a.get("enabled") == "false":
            flags.append("disabled")
        if not (text or desc or (rid and set(flags) & {"click", "scroll", "check"}) or set(flags) & {"scroll", "check"}):
            continue
        nodes.append({
            "cls": a.get("class", "").split(".")[-1],
            "text": text, "desc": desc, "id": rid.split(":id/")[-1] if rid else "", "rid": rid,
            "bounds": [x0, y0, x1, y1], "cx": (x0 + x1) // 2, "cy": (y0 + y1) // 2, "flags": flags,
        })
    # Compose switches have no text: take the label from the nearest text in the same row
    texts = [n for n in nodes if n["text"]]
    for nd in nodes:
        if "check" in nd["flags"] and not (nd["text"] or nd["desc"]):
            x0, y0, x1, y1 = nd["bounds"]
            row = [t for t in texts if y0 - 20 <= t["cy"] <= y1 + 20 and t["bounds"][0] < x1]
            if row:
                nd["near"] = min(row, key=lambda t: abs(t["cy"] - nd["cy"]) * 4 + abs(t["cx"] - nd["cx"]))["text"]
    for i, nd in enumerate(nodes):
        nd["i"] = i
    return nodes


PLAIN = {"TextView", "View", "ViewGroup", "FrameLayout", "LinearLayout", "RelativeLayout", "ConstraintLayout"}


def fmt_node(nd, full=True):
    """One node as a line. full: class always and @x,y (files, ui_diff); else compact (agent output)."""
    show_cls = full or nd["cls"] not in PLAIN
    s = f"[{nd['i']}]" + (f" {nd['cls']}" if show_cls else "")
    if nd["text"]:
        s += f' "{trunc(nd["text"])}"'
    if nd["desc"] and nd["desc"] != nd["text"]:
        s += f' desc="{trunc(nd["desc"])}"'
    if nd["id"]:
        s += f" id={nd['id']}"
    if nd.get("near"):
        s += f' near="{trunc(nd["near"], 40)}"'
    if full:
        s += f" @{nd['cx']},{nd['cy']}"
    if nd["flags"]:
        s += " " + ",".join(nd["flags"])
    return s


def trunc(s, n=60):
    s = s.replace("\n", " ")
    return s if len(s) <= n else s[:n - 1] + "…"


def similar_nodes(nodes, sel):
    """Nodes sharing a word stem (first 4 letters of words longer than 2) with the selector."""
    words = [w for w in re.split(r"\W+", sel.lower()) if len(w) > 2]
    return [n for n in nodes if any(w[:4] in (n["text"] + n["desc"] + n["id"]).lower() for w in words)]


def tree_text(nodes, limit=80):
    """UI tree lines for a file: at most limit lines, None — all (ui_diff reads the whole tree)."""
    lines = [fmt_node(n) for n in nodes[:limit]]
    if limit is not None and len(nodes) > limit:
        lines.append(f"… {len(nodes) - limit} more nodes")
    return "\n".join(lines) + "\n"


def ui_snapshot(serial, include_system=False):
    xml = dump_xml(serial)
    return xml, parse_nodes(xml, include_system)


def find_nodes(nodes, sel):
    """Exact match text → desc → id, then a case-insensitive substring."""
    for key in ("text", "desc"):
        hit = [n for n in nodes if n[key] == sel]
        if hit:
            return hit
    hit = [n for n in nodes if sel and (n["id"] == sel or n["rid"] == sel)]
    if hit:
        return hit
    low = sel.lower()
    return [n for n in nodes if low in n["text"].lower() or low in n["desc"].lower()]


# ---------------------------------------------------------------- commands: environment

# ---------------------------------------------------------------- Claude Code integration

def claude_dir():
    return os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude")


def load_settings(name="settings.json", strict=False):
    """A Claude Code settings file as a dict; {} if missing; strict — die on invalid JSON instead of {}."""
    p = os.path.join(claude_dir(), name)
    if not os.path.exists(p):
        return {}
    try:
        with open(p) as f:
            d = json.load(f)
    except ValueError as e:
        if strict:
            empty = " (the file is empty: delete it or write {} into it)" if os.path.getsize(p) == 0 else ""
            die(f"{p} is not valid JSON ({e}){empty} — add the hook by hand, see docs/configuration.md")
        return {}
    if isinstance(d, dict):
        return d
    if strict:
        die(f"{p} is not a JSON object — add the hook by hand, see docs/configuration.md")
    return {}


def adbm_plugin_installed():
    """The adbm plugin is installed and not switched off in enabledPlugins."""
    try:
        with open(os.path.join(claude_dir(), "plugins", "installed_plugins.json")) as f:
            keys = [k for k in (json.load(f).get("plugins") or {}) if k.split("@")[0] == "adbm"]
    except Exception:
        return False
    enabled = {**(load_settings().get("enabledPlugins") or {}), **(load_settings("settings.local.json").get("enabledPlugins") or {})}
    return any(enabled.get(k, True) is not False for k in keys)


def guard_command():
    """The hook command: through ~/.claude/skills/adbm when that link leads here, else the absolute path."""
    link = os.path.join(claude_dir(), "skills", "adbm")
    base = SKILL_DIR
    if os.path.realpath(link) == SKILL_DIR:
        base = link
    script = os.path.join(base, "hooks", "adbm-guard.py")
    home = os.path.relpath(script, os.path.expanduser("~"))
    path = f'"$HOME/{home}"' if not home.startswith("..") and '"' not in home and "$" not in home else shlex.quote(script)
    return f'f={path}; [ -f "$f" ] || exit 0; exec python3 "$f"'


def guard_installed(settings):
    hooks = settings.get("hooks") if isinstance(settings.get("hooks"), dict) else {}
    pre = hooks.get("PreToolUse") if isinstance(hooks.get("PreToolUse"), list) else []
    return any("adbm-guard" in str(h.get("command", "")) for e in pre if isinstance(e, dict)
               for h in (e.get("hooks") or []) if isinstance(h, dict))


def guard_anywhere():
    return guard_installed(load_settings()) or guard_installed(load_settings("settings.local.json"))


def agent_link():
    return os.path.join(claude_dir(), "agents", "adbm-eyes.md")


def agent_target():
    return os.path.join(SKILL_DIR, "agents", "adbm-eyes.md")


def install_guard():
    """Append the guard to hooks.PreToolUse of settings.json; everything else stays as it was."""
    p = os.path.join(claude_dir(), "settings.json")
    real = os.path.realpath(p)  # settings.json may be a symlink (dotfiles): write through it
    settings = load_settings(strict=True)
    if guard_installed(settings):
        return
    if not isinstance(settings.get("hooks"), dict):
        settings["hooks"] = {}
    if not isinstance(settings["hooks"].get("PreToolUse"), list):
        settings["hooks"]["PreToolUse"] = []
    settings["hooks"]["PreToolUse"].append(
        {"matcher": "Read", "hooks": [{"type": "command", "command": guard_command()}]})
    os.makedirs(os.path.dirname(real), exist_ok=True)
    tmp = real + ".adbm-tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps(settings, ensure_ascii=False, indent=2) + "\n")
    if os.path.exists(real):
        shutil.copy2(real, real + ".adbm-backup")
        shutil.copymode(real, tmp)
    os.replace(tmp, real)


def install_agent():
    link = agent_link()
    os.makedirs(os.path.dirname(link), exist_ok=True)
    if os.path.lexists(link):
        if not os.path.islink(link):
            shutil.copy2(link, link + ".adbm-backup")
        os.remove(link)
    os.symlink(agent_target(), link)


# ---------------------------------------------------------------- settings: subagent models and devices

CONFIG_DEFAULTS = {"adbm-eyes": {"model": "haiku", "effort": "low"},
                   "devices": {"apis": "", "image": "google_apis", "profile": "pixel_8"}}
EFFORTS = ("low", "medium", "high", "xhigh", "max")
MODEL_ALIASES = ("sonnet", "opus", "haiku", "fable")
CONFIG_TEMPLATE = """\
# adbm settings. A project's .adbm/config.ini overrides values from ~/.config/adbm/config.ini.
# Claude Code: the adbm skill passes these values to the Agent tool when it starts a subagent.
# Another agent tool: adapt the "adbm-eyes subagent" section of SKILL.md to it.

[adbm-eyes]
# The subagent that looks at frames. Model alias of the Agent tool: sonnet, opus, haiku, fable.
# Empty: the default of the agent type (in the general-purpose fallback: the main session's model).
model = {model}
# Reasoning effort: low, medium, high, xhigh, max. Empty: the usual effort.
effort = {effort}

[devices]
# API levels a command uses without --api, e.g. 28, 33, 35. Empty: the one running emulator, or API 35.
# `adbm setup --yes` downloads the missing system images and creates AVDs; `adbm devices --start` boots them.
apis =
# System image variant for new AVDs: google_apis (allows adb root) or google_apis_playstore.
# Not set: a system image already on disk of any variant, else google_apis.
# image = {image}
# AVD device profile for new AVDs, see `avdmanager list device`.
# profile = {profile}
""".format(**CONFIG_DEFAULTS["adbm-eyes"], **{k: v for k, v in CONFIG_DEFAULTS["devices"].items() if k != "apis"})


def config_paths():
    user = os.path.join(os.path.expanduser(os.environ.get("XDG_CONFIG_HOME") or "~/.config"), "adbm", "config.ini")
    return [("user", user), ("project", os.path.join(project_root(), ".adbm", "config.ini"))]


def check_value(sec, k, v):
    """(normalized value, None) or (None, what is wrong)."""
    v = v.strip() if k == "profile" else v.strip().lower()
    if k == "effort" and v and v not in EFFORTS:
        return None, f"effort={v}, allowed: {', '.join(EFFORTS)} or empty"
    if k == "model" and v and v not in MODEL_ALIASES:
        return None, f"model={v}, allowed: {', '.join(MODEL_ALIASES)} or empty"
    if k == "apis":
        parts = [x.strip() for x in v.split(",") if x.strip()]
        if not all(x.isdigit() for x in parts):
            return None, f"apis={v}, want API levels like 28, 33, 35"
        v = ", ".join(dict.fromkeys(str(int(x)) for x in parts))
    if k in ("image", "profile") and not re.fullmatch(r"[\w.\- ]+", v):
        return None, f"{k}={v or '(empty)'}, want a name like " + ("google_apis" if k == "image" else "pixel_8")
    return v, None


def config_text(path):
    """The template; for the project file with keys commented out, as it overrides the user file."""
    if path != dict(config_paths())["project"]:
        return CONFIG_TEMPLATE
    return re.sub(r"(?m)^(\w+ =)", r"# \1", CONFIG_TEMPLATE)


def config_set(path, sec, key, value):
    """Set one key in an INI file, keeping comments and other keys."""
    text = open(path, encoding="utf-8").read() if os.path.exists(path) else config_text(path)
    lines = text.splitlines()
    cur, end, plain, commented = None, None, None, None
    for i, ln in enumerate(lines):
        m = re.match(r"\s*\[([^\]]+)\]", ln)
        if m:
            if cur == sec and end is None:
                end = i
            cur = m.group(1).strip()
        elif cur == sec and plain is None and re.match(rf"\s*{key}\s*=", ln):
            plain = i
        elif cur == sec and commented is None and re.match(rf"\s*#\s*{key}\s*=", ln):
            commented = i
    if cur == sec and end is None:
        end = len(lines)
    new = f"{key} = {value}"
    if plain is not None or commented is not None:
        lines[plain if plain is not None else commented] = new
    elif end is not None:
        while end > 0 and not lines[end - 1].strip():
            end -= 1
        lines.insert(end, new)
    else:
        lines += ["", f"[{sec}]", new]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def load_config():
    """Settings: {section: {key: (value, source)}} with the project over the user file, and problems."""
    cfg = {sec: {k: (v, "default") for k, v in d.items()} for sec, d in CONFIG_DEFAULTS.items()}
    problems = []
    for src, path in config_paths():
        if not os.path.exists(path):
            continue
        # no DEFAULT section: its keys would leak into every section
        cp = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=("#", ";"), default_section="\0")
        try:
            if not cp.read(path, encoding="utf-8"):
                problems.append(f"{rel(path)}: cannot read the file")
                continue
        except (configparser.Error, UnicodeDecodeError) as e:
            problems.append(f"{rel(path)}: {str(e).splitlines()[0]}")
            continue
        for sec in cp.sections():
            if sec not in cfg:
                problems.append(f"{rel(path)}: unknown section [{sec}], known: {', '.join(cfg)}")
                continue
            for k, v in cp.items(sec):
                if k not in cfg[sec]:
                    problems.append(f"{rel(path)}: [{sec}] unknown key {k}, known: {', '.join(cfg[sec])}")
                    continue
                v, err = check_value(sec, k, v)
                if k == "apis" and v == "":
                    continue  # empty: not set here, a lower layer decides
                if err:
                    problems.append(f"{rel(path)}: [{sec}] {err}")
                else:
                    cfg[sec][k] = (v, src)
    return cfg, problems


WARNED = set()


@functools.lru_cache(maxsize=None)
def config_loaded():
    return load_config()


def config_get(sec, key):
    """One setting; problems of that section go to stderr once, the bad value falls back."""
    cfg, problems = config_loaded()
    for p in problems:
        if (f"[{sec}]" in p or "[" not in p) and p not in WARNED:
            WARNED.add(p)
            print(f"! config: {p}", file=sys.stderr)
    return cfg[sec][key][0]


def config_apis():
    return parse_apis(config_get("devices", "apis")) or []


def agent_line(name, d):
    return f"{name}  " + "  ".join(f"{k}={v or '-'} ({src})" for k, (v, src) in d.items())


def cmd_config(a):
    if a.project and not (a.init or a.set):
        die("--project works only with --init or --set")
    path = dict(config_paths())["project" if a.project else "user"]
    if a.init:
        if os.path.exists(path):
            die(f"{rel(path)} already exists — edit it or use --set")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(config_text(path))
        print(f"written {rel(path)}")
    for item in a.set or []:
        m = re.fullmatch(r"([\w-]+)\.(\w+)=(.*)", item)
        if not m or m.group(1) not in CONFIG_DEFAULTS or m.group(2) not in CONFIG_DEFAULTS[m.group(1)]:
            die(f"--set {item}: want section.key=value, keys: "
                + ", ".join(f"{s}.{k}" for s, d in CONFIG_DEFAULTS.items() for k in d))
        sec, key, value = m.groups()
        value, err = check_value(sec, key, value)
        if err:
            die(f"--set {item}: {err}")
        config_set(path, sec, key, value)
        print(f"{rel(path)}: [{sec}] {key} = {value or '(empty)'}")
    cfg, problems = load_config()
    for name, d in cfg.items():
        print(agent_line(name, d))
    for p in problems:
        print("! " + p)
    print("files: " + ", ".join(f"{rel(p)}{'' if os.path.exists(p) else ' (none)'}" for _, p in config_paths()))
    return 1 if problems else 0


def claude_rows():
    """doctor rows for the Claude Code side: the guard hook and the adbm-eyes agent."""
    if not os.path.isdir(claude_dir()):
        return [(None, "Claude Code", f"no {rel(claude_dir())} — guard hook and adbm-eyes not checked",
                 "adbm setup --hook --agent --yes")]
    if adbm_plugin_installed():
        return [(True, "guard hook, adbm-eyes", "from the adbm plugin", "")]
    ok = guard_anywhere()
    rows = [(True if ok else None, "guard hook", "denies Read of full frames" if ok else "Read of a full frame is not denied",
             "ask the person, then adbm setup --hook --yes")]
    link = agent_link()
    ok = os.path.realpath(link) == agent_target()
    rows.append((True if ok else None, "adbm-eyes agent", rel(link) if ok else
                 ("another file at " + rel(link) if os.path.lexists(link) else "falls back to general-purpose"),
                 "ask the person, then adbm setup --agent --yes"))
    return rows


def cmd_doctor(a):
    rows = []

    def row(ok, name, detail, fix=""):
        rows.append(("ok" if ok is True else ("missing" if ok is False else "!"), name, detail, fix))

    root = sdk_root()
    if root and not os.path.isdir(root):
        row(False, "Android SDK", f"{root} — no such folder", "check ANDROID_HOME")
        root = None
    else:
        row(bool(root), "Android SDK", root or "ANDROID_HOME is not set and no standard path exists",
        "install Android Studio or cmdline-tools, set ANDROID_HOME")
    adbp = sdk_tool("platform-tools", "adb")
    row(bool(adbp), "adb", adbp or "-", "sdkmanager platform-tools")
    emu = sdk_tool("emulator", "emulator")
    if emu:
        inpath = shutil.which("emulator")
        row(True if inpath else None, "emulator", emu + ("" if inpath else " (not in PATH — adbm finds it itself)"))
    else:
        row(False, "emulator", "-", "sdkmanager emulator")
    sdkm = sdk_tool("cmdline-tools/latest/bin", "sdkmanager")
    row(bool(sdkm), "sdkmanager/avdmanager", sdkm or "-",
        "Android Studio → SDK Manager → SDK Tools → Command-line Tools")
    code, out, err = sh(["java", "-version"], timeout=20)
    m = re.search(r'version "(\d+)', out + err)
    jv = int(m.group(1)) if m else 0
    row(jv >= 17, "Java 17+", f"java {jv}" if jv else "java not found", pkg_hint("openjdk@17", "openjdk-17-jdk"))
    mae = maestro_bin()
    if mae:
        _, o, _ = sh([mae, "--version"], timeout=60)
        row(True, "Maestro", (o.strip().splitlines() or ["?"])[-1])
    else:
        row(False, "Maestro", "needed for adbm run", "adbm setup --maestro --yes")
    try:
        import PIL
        row(True, "Pillow", PIL.__version__)
    except ImportError:
        row(False, "Pillow", "needed for contact sheet, diff, look", PILLOW_HINT)
    ff = shutil.which("ffmpeg")
    row(bool(ff) or None, "ffmpeg", ff or "needed only for record", pkg_hint("ffmpeg", "ffmpeg"))
    acli = android_cli()
    row(True if acli else None, "Android CLI (optional)", acli or "only for screens without a UI tree (annotate, tap #N); the rest works without it",
        "adbm setup --android-cli --yes")
    for ok, name, detail, fix in claude_rows():
        row(ok, name, detail, fix)
    cfg, problems = load_config()
    row(None if problems else True, "config", "; ".join(problems) or
        f"adbm-eyes {cfg['adbm-eyes']['model'][0] or '-'}/{cfg['adbm-eyes']['effort'][0] or '-'}, "
        f"API {cfg['devices']['apis'][0] or '-'}", "adbm config" if problems else "")
    want = parse_apis(cfg["devices"]["apis"][0]) or []
    if not want:
        row(None, "config API levels", "not set: commands without --api take the one running emulator or API 35",
            "ask the person, then adbm config --set devices.apis=28,33,35 --project")
    else:
        avds = avd_index()
        miss = [f"API {n_}: no phone AVD" for n_ in want if not phone_avds(avds, n_)]
        row(False if miss else True, "config API levels", "; ".join(miss) or ", ".join(map(str, want)) + " — AVDs exist",
            "adbm setup --yes")
    # system images and AVDs
    if root:
        imgs = sorted(glob.glob(os.path.join(root, "system-images", "android-*", "*", "*")))
        names = [os.path.relpath(p, os.path.join(root, "system-images")) for p in imgs]
        row(bool(names) or None, "System images", ", ".join(names) or "none", "adbm setup --api 35")
    avds = avd_index()
    if not avds:
        row(None, "AVD", "none", "adbm setup --api 35 --yes")
    for name, info in avds.items():
        cfg = info["config"]
        bad = [f"{k}={cfg.get(k, '') or '-'}" for k in TUNE if below_tune(k, cfg.get(k, ""))]
        detail = f"API {info['api']}" + (" · " + ", ".join(bad) if bad else "")
        row(None if bad else True, f"AVD {name}", detail, "adbm setup --tune --yes" if bad else "")
    w = [max(len(r[i]) for r in rows) for i in range(3)]
    for r in rows:
        line = f"{r[0]:<{w[0]}}  {r[1]:<{w[1]}}  {r[2]}"
        if r[3] and r[0] != "ok":
            line += f"  → {r[3]}"
        print(line)
    missing = [r for r in rows if r[0] == "missing"]
    warn = [r for r in rows if r[0] == "!"]
    print(f"\nsummary: ok {len(rows) - len(missing) - len(warn)}, warnings {len(warn)}, missing {len(missing)}"
          + (" — fix: " + ", ".join(r[1] for r in missing) if missing else ""))
    return 1 if missing else 0


def to_mb(v):
    m = re.match(r"(\d+(?:\.\d+)?)\s*([KMGT]?)", str(v).upper())
    if not m:
        return 0
    n, u = float(m.group(1)), m.group(2)
    return n * {"": 1, "K": 1 / 1024, "M": 1, "G": 1024, "T": 1024 * 1024}[u]


@functools.lru_cache(maxsize=None)
def abi():
    arm = platform.machine() in ("arm64", "aarch64")
    if not arm and sys.platform == "darwin":  # python under Rosetta reports x86_64 on Apple Silicon
        arm = sh(["sysctl", "-n", "hw.optional.arm64"], timeout=5)[1].strip() == "1"
    return "arm64-v8a" if arm else "x86_64"


def below_tune(k, have):
    """True if an AVD config value is worse than TUNE; bigger memory, disk or cores stay."""
    want = TUNE[k]
    if k in ("hw.ramSize", "vm.heapSize", "disk.dataPartition.size"):
        return to_mb(have) < to_mb(want)
    if k == "hw.cores":
        return not have.isdigit() or int(have) < int(want)
    return have != want


def tune_config(path):
    p = os.path.join(path, "config.ini")
    lines = open(p).read().splitlines() if os.path.exists(p) else []
    seen = set()
    out = []
    for line in lines:
        k, _, v = (x.strip() for x in line.partition("="))
        if k in TUNE:
            out.append(f"{k}={TUNE[k]}" if below_tune(k, v) else line)
            seen.add(k)
        else:
            out.append(line)
    out += [f"{k}={v}" for k, v in TUNE.items() if k not in seen]
    open(p, "w").write("\n".join(out) + "\n")


def cmd_setup(a):
    steps = []  # (description, command | callable)
    root = sdk_root()
    sdkm = sdk_tool("cmdline-tools/latest/bin", "sdkmanager")
    avdm = sdk_tool("cmdline-tools/latest/bin", "avdmanager")
    avds = avd_index()
    running = {d["name"] for d in list_devices() if d["emulator"]} if sdk_tool("platform-tools", "adb") else set()
    apis = parse_apis(a.api)
    if apis is None and not (a.tune or a.maestro or a.hook or a.agent or a.android_cli):
        apis = config_apis()
        if not apis:
            die("pass --api 28,33,35, or ask the person and run adbm config --set devices.apis=28,33,35 --project")
    image, profile = config_get("devices", "image"), config_get("devices", "profile")
    dev_cfg = config_loaded()[0]["devices"]
    any_variant = dev_cfg["image"][1] == "default"
    for api in apis or []:
        have_avd = phone_avds(avds, api)
        if have_avd:
            name, info = have_avd[0], avds[have_avd[0]]
            sysdir = info["config"].get("image.sysdir.1", "").strip("/")
            if root and sysdir and not os.path.isdir(os.path.join(root, sysdir)):
                if not sdkm:
                    die("no sdkmanager — install Command-line Tools (see `adbm doctor`)")
                steps.append((f"system image of {name} (missing on disk)", [sdkm, ";".join(sysdir.split("/")[:4])]))
            variant = (sysdir.split("/") + ["", "", ""])[2]
            prof = info["config"].get("hw.device.name", "")
            if not any_variant and variant and variant != image:
                print(f"API {api}: {name} uses {variant}, the config wants {image} — delete the AVD to recreate it")
            if dev_cfg["profile"][1] != "default" and prof and prof != profile:
                print(f"API {api}: {name} uses profile {prof}, the config wants {profile} — delete the AVD to recreate it")
            continue
        # an image already on disk: the configured variant, or any variant when none is configured
        have_img = root and (glob.glob(os.path.join(root, "system-images", f"android-{api}", image, abi()))
                             or any_variant and [p_ for v in PHONE_IMAGES for p_ in
                                                 glob.glob(os.path.join(root, "system-images", f"android-{api}", v, abi()))])
        pkg = f"system-images;android-{api};{image};{abi()}"
        if not have_img:
            if not sdkm:
                die("no sdkmanager — install Command-line Tools (see `adbm doctor`)")
            steps.append((f"system image API {api}", [sdkm, pkg]))
        else:
            pkg = "system-images;" + ";".join(os.path.relpath(have_img[0], os.path.join(root, "system-images")).split(os.sep))
        name = f"adbm_API_{api}"
        if not avdm:
            die("no avdmanager — install Command-line Tools (see `adbm doctor`)")
        steps.append((f"AVD {name}", ["sh", "-c", f"echo no | {shlex.quote(avdm)} create avd -n {name} -k {shlex.quote(pkg)} -d {shlex.quote(profile)}"]))
        steps.append((f"tune {name}", lambda n=name: tune_config(avd_index()[n]["path"])))
    if a.tune:
        for name, info in avds.items():
            if a.api and info["api"] not in parse_apis(a.api):
                continue
            if name in running:
                print(f"skip {name}: the emulator is running, stop it and retry")
                continue
            steps.append((f"tune {name} (raise to {', '.join(f'{k}={v}' for k, v in TUNE.items())}; bigger values stay)",
                          lambda p=info["path"]: tune_config(p)))
    if a.maestro and not maestro_bin():
        steps.append(("Maestro", ["brew", "install", "mobile-dev-inc/tap/maestro"] if shutil.which("brew")
                      else ["sh", "-c", "curl -fsSL https://get.maestro.mobile.dev | bash"]))
    if a.hook:
        load_settings(strict=True)  # invalid JSON stops the plan before anything is installed
        have = guard_anywhere()
        if adbm_plugin_installed():
            print("guard hook: comes with the adbm plugin, nothing to add")
        elif not have:
            steps.append((f"guard hook: append to hooks.PreToolUse in {rel(os.path.join(claude_dir(), 'settings.json'))}"
                          " — every Read of a full adbm frame or raw UI dump will be denied, in every project"
                          " (a copy of the old file goes to settings.json.adbm-backup)", install_guard))
    if a.agent:
        if adbm_plugin_installed():
            print("adbm-eyes agent: comes with the adbm plugin, nothing to add")
        elif os.path.realpath(agent_link()) != agent_target():
            steps.append((f"adbm-eyes agent: link {rel(agent_link())} → {agent_target()}"
                          + (" (the file there goes to adbm-eyes.md.adbm-backup)" if os.path.lexists(agent_link())
                             and not os.path.islink(agent_link()) else ""), install_agent))
    if a.android_cli and not android_cli():
        if shutil.which("brew"):
            steps.append(("Android CLI (adbm calls it with --no-metrics; do not run `android init`)",
                          ["brew", "install", "--cask", "android-cli"]))
        else:
            print("Android CLI: no Homebrew — install it by hand: https://developer.android.com/tools/agents/android-cli")
    if root and any(not callable(c) and c[0] == sdkm for _, c in steps) \
            and not os.path.exists(os.path.join(root, "licenses", "android-sdk-license")):
        msg = ("the Android SDK licenses are not accepted, so sdkmanager cannot download images. "
               f"Show the person the licenses: {sdkm} --licenses — they accept them, then run setup again")
        if a.yes:
            die(msg)
        print("warning: " + msg)
    if not steps:
        print("nothing to do: everything is installed")
        return 0
    for d, c in steps:
        print(("• " if a.yes else "plan: ") + d + ("" if callable(c) else "  $ " + " ".join(shlex.quote(x) for x in c)))
    if not a.yes:
        print("\nthis is a plan. To run it: the same command with --yes")
        if a.hook or a.agent:
            print("--hook and --agent change the person's Claude Code settings: show them this plan and run --yes only after they agree")
        return 0
    for d, c in steps:
        if callable(c):
            c()
        else:
            try:
                code = subprocess.call(c)
            except FileNotFoundError:
                die(f"step \"{d}\": {c[0]} not found")
            if code != 0:
                die(f"step \"{d}\" failed with code {code}")
        print(f"done: {d}")
    return 0


def emulator_start(avd, headless):
    emu = sdk_tool("emulator", "emulator")
    if not emu:
        die("no emulator — `adbm doctor`")
    os.makedirs(CACHE, exist_ok=True)
    log = open(os.path.join(CACHE, f"emu-{avd}.log"), "w")
    cmd = [emu, "-avd", avd, "-no-snapshot-save", "-no-boot-anim"]
    if headless:
        cmd.append("-no-window")
        if sys.platform.startswith("linux") and not glob.glob("/dev/dri/renderD*"):  # no GPU for hw.gpu.mode=host
            cmd += ["-gpu", "swiftshader_indirect"]
    subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)


def wait_boot(avd, timeout=300):
    t0 = time.time()
    serial = None
    while time.time() - t0 < timeout:
        if not serial:
            for d in list_devices():
                if d["emulator"] and d["name"] == avd:
                    serial = d["serial"]
        # boot_completed comes before the package manager is ready: install and launch need pm
        if serial and ashell(serial, "getprop sys.boot_completed", timeout=10) == "1" \
                and ashell(serial, "pm path android", timeout=15).startswith("package:"):
            return serial
        time.sleep(3)
    return None


def cmd_devices(a):
    if a.stop:
        want = parse_apis(a.stop)
        devs = [d for d in list_devices() if d["emulator"] and d["api"] in want]
        for d in devs:
            code, out, err = adb(d["serial"], "emu", "kill", timeout=20)
            print(f"API {d['api']}: " + (f"stopping {d['name']}" if code == 0 else f"error — {(out + err).strip()[:120]}"))
        for api in sorted(set(want) - {d["api"] for d in devs}):
            print(f"API {api}: no running emulator")
        return 0 if devs else 1
    if a.start is not None:
        want = parse_apis(a.start) or config_apis()
        if not want:
            die("pass --start 28,33,35, or ask the person and run adbm config --set devices.apis=28,33,35 --project")
        devs = list_devices()
        avds = avd_index()
        todo = []
        for api in want:
            if any(d["api"] == api and d["emulator"] for d in devs):
                continue
            names = phone_avds(avds, api)
            if not names:
                print(f"API {api}: no phone AVD → adbm setup --api {api} --yes")
                continue
            emulator_start(names[0], a.headless)
            todo.append(names[0])
            print(f"API {api}: starting {names[0]}")
        if todo:
            with cf.ThreadPoolExecutor(len(todo)) as ex:
                for avd, s in zip(todo, ex.map(wait_boot, todo)):
                    print(f"{avd}: " + (f"booted → {s}" if s else f"did not boot in 5 min, log {CACHE}/emu-{avd}.log"))
    devs = list_devices()
    bad = {s: st for s, st in adb_states().items() if st != "device"}
    for s_, st in bad.items():
        print(f"{s_}: {st} — {state_hint(st)}")
    if not devs:
        print("no devices")
        return 1
    print("API  serial                 name               screen")
    for d in devs:
        w, h = screen_size(d["serial"])
        dens = (ashell(d["serial"], "wm density").split() or ["?"])[-1] if d["api"] else "?"
        kind = "" if d["emulator"] else "  (physical)"
        print(f"{d['api']:<4} {d['serial'][:22]:<22} {d['name'][:18]:<18} {w}x{h} {dens}dpi{kind}")
    return 0


# ---------------------------------------------------------------- commands: preparation

DEMO = [
    "settings put global sysui_demo_allowed 1",
    "am broadcast -a com.android.systemui.demo -e command enter",
    "am broadcast -a com.android.systemui.demo -e command clock -e hhmm 1200",
    "am broadcast -a com.android.systemui.demo -e command battery -e level 100 -e plugged false",
    "am broadcast -a com.android.systemui.demo -e command network -e wifi show -e level 4 -e fully true",
    "am broadcast -a com.android.systemui.demo -e command network -e mobile show -e datatype none -e level 4",
    "am broadcast -a com.android.systemui.demo -e command notifications -e visible false",
]


AXES = ("theme", "nav", "font_scale")
DEFAULT_AXES = {"theme": "light", "nav": "threebutton", "font_scale": "1.0"}


def device_axes(api, serial):
    """Theme, navigation mode and font scale the device has now."""
    out = ashell(serial, "cmd uimode night; settings get system font_scale; cmd overlay list 2>/dev/null | grep navbar",
                 timeout=20)
    theme = "dark" if re.search(r"Night mode: yes", out) else ("light" if "Night mode: no" in out else None)
    m = re.search(r"\[x\] com\.android\.internal\.systemui\.navbar\.(\w+)", out)
    fs = re.search(r"^(\d+(?:\.\d+)?)\s*$", out, re.M)
    return {"theme": theme, "nav": m.group(1) if m else None, "font_scale": fs.group(1) if fs else None}


def pinned_path(serial):
    return os.path.join(CACHE, f"prep-{serial}.json")


def load_pinned(api, serial):
    """Axes set by hand with `adbm prep`: `adbm run` keeps them for cells without these axes."""
    try:
        d = json.load(open(pinned_path(serial)))
        return d["axes"] if d.get("api") == api else {}
    except Exception:
        return {}


def same_scale(a, b):
    try:
        return abs(float(a) - float(b)) < 1e-3
    except (TypeError, ValueError):
        return False


def prep_device(api, serial, theme=None, nav=None, font_scale=None, locale=None, app=None, reset=False):
    """Set and check theme, navigation, font scale, locale; animations off, demo mode on.

    Returns (ok, text). Only axes that differ from the device are changed: a navbar change restarts the system UI.
    """
    notes, errors = [], []
    if reset:
        theme, nav, font_scale = DEFAULT_AXES["theme"], DEFAULT_AXES["nav"], DEFAULT_AXES["font_scale"]
    have = device_axes(api, serial)
    cmds = []
    if theme and have["theme"] != theme:
        cmds.append(f"cmd uimode night {'yes' if theme == 'dark' else 'no'}")
    if font_scale and not same_scale(have["font_scale"], font_scale):
        cmds.append(f"settings put system font_scale {font_scale}")
    if nav:
        if api and api < 29:
            if not reset:
                notes.append(f"nav={nav} skipped: API {api} < 29")
            nav = None
        elif have["nav"] != nav:
            cmds.append(f"cmd overlay enable-exclusive --category com.android.internal.systemui.navbar.{nav}")
    if locale or (reset and app):
        if api >= 33 and app:
            cmds.append(f"cmd locale set-app-locales {app}" + (f" --locales {locale}" if locale and not reset else ""))
        elif not reset:
            notes.append("locale skipped: needs API 33+ and --app <package>")
    scale = "1" if reset else "0"
    cmds += [f"settings put global {k} {scale}" for k in
             ("window_animation_scale", "transition_animation_scale", "animator_duration_scale")]
    if not reset:
        cmds.append("settings put secure show_ime_with_hard_keyboard 0")
    ashell(serial, "; ".join(c + " >/dev/null 2>&1" for c in cmds), timeout=60)
    if any("navbar" in c for c in cmds):
        time.sleep(3)
    elif any("uimode" in c or "font_scale" in c for c in cmds):
        time.sleep(1.5)
    now = device_axes(api, serial)
    if theme and now["theme"] != theme:
        errors.append(f"theme is {now['theme']}, wanted {theme}")
    if nav and now["nav"] != nav:
        errors.append(f"nav is {now['nav']}, wanted {nav}")
    if font_scale and not same_scale(now["font_scale"], font_scale):
        errors.append(f"font scale is {now['font_scale']}, wanted {font_scale}")
    # after a theme change the status bar is recreated while demo mode still counts as on, so a
    # repeated enter is ignored (seen on API 28) — hence exit first
    demo = ["am broadcast -a com.android.systemui.demo -e command exit"] + ([] if reset else DEMO)
    ashell(serial, "; ".join(c + " >/dev/null 2>&1" for c in demo), timeout=60)
    if reset:
        s = "reset: animations 1, demo mode off, theme light, font scale 1.0" + (", nav threebutton" if api >= 29 else "")
        s += ", app locale follows the system" if app and api >= 33 else ""
    else:
        s = "animations 0, demo mode"
        s += f", theme {theme}" if theme else ""
        s += f", nav {nav}" if nav else ""
        s += f", font scale {font_scale}" if font_scale else ""
        s += f", locale {locale}" if locale and api >= 33 and app else ""
    if errors:
        return False, "error — " + "; ".join(errors) + f" (after: {s})"
    return True, s + ("; " + "; ".join(notes) if notes else "")


def cmd_prep(a):
    targets = pick(a, multi=True)
    res = parallel(targets, lambda api, s: prep_device(api, s, a.theme, a.nav, a.font_scale, a.locale, a.app, a.reset))
    os.makedirs(CACHE, exist_ok=True)
    for (api, s), (ok, _) in zip(targets, res):
        if a.reset:
            with contextlib.suppress(FileNotFoundError):
                os.remove(pinned_path(s))
        elif ok:
            axes = {**load_pinned(api, s), **{k: getattr(a, k) for k in AXES if getattr(a, k)}}
            json.dump({"api": api, "axes": axes}, open(pinned_path(s), "w"))
    for (api, s), (ok, r) in zip(targets, res):
        print(f"{api}: {r}")
    return 0 if all(ok for ok, _ in res) else 1


def apk_info(apk):
    """{'package', 'min_sdk', 'target_sdk'} from aapt dump badging; missing ones are None."""
    info = {"package": None, "min_sdk": None, "target_sdk": None, "tool": None}
    root = sdk_root()
    tools = sorted(glob.glob(os.path.join(root, "build-tools", "*", "aapt")),
                   key=lambda t: [int(x) if x.isdigit() else 0 for x in re.split(r"[.-]", t.split(os.sep)[-2])]) if root else []
    if tools:
        info["tool"] = tools[-1]
        _, out, _ = sh([tools[-1], "dump", "badging", apk], timeout=60)
        for key, rx in (("package", r"package: name='([^']+)'"), ("min_sdk", r"^sdkVersion:'(\d+)'"),
                        ("target_sdk", r"^targetSdkVersion:'(\d+)'")):
            m = re.search(rx, out, re.M)
            if m:
                info[key] = int(m.group(1)) if key != "package" else m.group(1)
    return info


def cmd_install(a):
    if not os.path.exists(a.apk):
        die(f"no such file {a.apk}")
    targets = pick(a, multi=True)
    run = current_run(create=False) or project_cache()
    info = apk_info(a.apk)
    pkg = info["package"]
    if not info["tool"]:
        print("minSdk unknown: no aapt in build-tools — minSdk is not checked")
    low = [t for t in targets if info["min_sdk"] and t[0] < info["min_sdk"]]
    for api, _ in low:
        print(f"{api}: skipped — the APK has minSdk {info['min_sdk']}")
    targets = [t for t in targets if t not in low]
    if not targets:
        die(f"no devices with API ≥ {info['min_sdk']} (APK minSdk)")
    h = hashlib.sha1()
    with open(a.apk, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    sha = h.hexdigest()[:10]

    def one(api, s):
        code, out, err = adb(s, "install", "-r", "-d", "-t", a.apk, timeout=300)
        ok = code == 0 and "Success" in out
        return ok, ((out + err).strip().splitlines() or [f"adb install returned {code}"])[-1] if not ok else ""

    res = parallel(targets, one)
    bad = 0
    for (api, s), (ok, msg) in zip(targets, res):
        print(f"{api}: " + ("installed" if ok else f"error — {msg}"))
        bad += not ok
    if bad == len(targets):
        print(f"{a.as_}: nothing installed — builds.json is unchanged")
        return 1
    meta_p = os.path.join(run, "builds.json")
    try:
        meta = json.load(open(meta_p))
    except Exception:
        meta = {}
    other = meta.get("before" if a.as_ == "after" else "after", {}).get("package")
    if pkg and other and other != pkg:
        print(f"warning: package {pkg} differs from the other build ({other}) — before/after compare different apps")
    meta[a.as_] = {"apk": os.path.abspath(a.apk), "package": pkg, "sha1": sha,
                   "min_sdk": info["min_sdk"], "target_sdk": info["target_sdk"]}
    json.dump(meta, open(meta_p, "w"), ensure_ascii=False, indent=1)
    sdk = f" minSdk {info['min_sdk']} targetSdk {info['target_sdk']}" if info["min_sdk"] else ""
    print(f"{a.as_}: {os.path.basename(a.apk)} {pkg or ''}{sdk} sha1 {sha}")
    with _lock:
        open(os.path.join(run, ".as"), "w").write(a.as_)
    return 1 if bad else 0


# ---------------------------------------------------------------- commands: navigation

def cmd_ui(a):
    api, s = pick(a)[0]
    xml, nodes = ui_snapshot(s, a.all)
    save_ui_cache(s, nodes)
    open(os.path.join(scratch(), "logs", f"ui-api{api}-last.xml"), "w").write(xml)
    if a.find:
        hit = find_nodes(nodes, a.find)
        if not hit:
            near = similar_nodes(nodes, a.find)[:5]
            print(f'not found: "{a.find}"' + (" · similar:" if near else f" · nothing similar, {len(nodes)} nodes — adbm ui"))
            for nd in near:
                print("  " + fmt_node(nd, a.xy))
            return 1
        nodes = hit
    for nd in nodes[: a.limit]:
        print(fmt_node(nd, a.xy))
    if len(nodes) > a.limit:
        print(f"… {len(nodes) - a.limit} more, narrow with --find")
    w, h = screen_size(s)
    print(f"# API {api} {w}x{h} · nodes {len(nodes)}")
    return 0


def tap_xy(serial, x, y, how=""):
    """Tap, long press (1 s) or double tap; True if adb succeeded."""
    cmd = {"long": f"input swipe {x} {y} {x} {y} 1000",
           # each `input` start takes ~0.3 s: two sequential taps are too far apart for a double tap
           "double": f"(input tap {x} {y} &); sleep 0.1; input tap {x} {y}; sleep 0.3"}.get(how, f"input tap {x} {y}")
    return adb_ok(serial, cmd)[0]


def tap_how(a):
    return "long" if getattr(a, "long", False) else ("double" if getattr(a, "double", False) else "")


def cmd_tap(a):
    api, s = pick(a)[0]
    sel = a.selector
    if sel.startswith("text:"):
        sel = sel[5:]
        if not sel:
            die("text: needs the text to tap")
    elif re.fullmatch(r"\d+,\d+", sel):
        x, y = map(int, sel.split(","))
        if not tap_xy(s, x, y, tap_how(a)):
            die(f"[{s}] input tap failed")
        session_log({"api": api, "op": "tap_xy", "x": x, "y": y, "screen": screen_size(s), "how": tap_how(a)})
        print(f"{api}: tap {x},{y}")
        return after_tap(api, s, a, None)
    elif re.fullmatch(r"#\d+", sel):
        return annotate_tap(api, s, sel[1:], a)
    if a.index is not None or re.fullmatch(r"\[\d+\]", sel) and sel == a.selector:
        idx = a.index if a.index is not None else int(sel[1:-1])
        try:
            nd = json.load(open(os.path.join(CACHE, f"ui-{s}.json")))[idx]
        except Exception:
            die("no fresh `adbm ui` for this device")
        # the index comes from the last `adbm ui`: tap only if that node is still on the screen
        _, nodes = ui_snapshot(s)
        same = [n for n in nodes if (n["text"], n["desc"], n["id"], n["bounds"]) == (nd["text"], nd["desc"], nd["id"], nd["bounds"])]
        if not same:
            die(f"{fmt_node(nd, False)} is no longer on the screen — run adbm ui again")
        nd = same[0]
        if not tap_xy(s, nd["cx"], nd["cy"], tap_how(a)):
            die(f"[{s}] input tap failed")
        session_log({"api": api, "op": "tap", "text": nd["text"], "desc": nd["desc"], "id": nd["id"], "how": tap_how(a)})
        print(f"{api}: tap {fmt_node(nd, False)}")
        return after_tap(api, s, a, nodes)
    scrolls = 0
    nodes = []
    a.retries = max(1, a.retries)
    for i in range(a.retries + a.scroll):
        _, nodes = ui_snapshot(s)
        hit = find_nodes(nodes, sel)
        if not hit and i >= 1 and scrolls < a.scroll:
            w, h = screen_size(s)
            adb(s, "shell", f"input swipe {w // 2} {int(h * .7)} {w // 2} {int(h * .35)} 300")
            scrolls += 1
            time.sleep(0.6)
            continue
        if hit:
            nd = hit[min(a.nth, len(hit) - 1)]
            if not tap_xy(s, nd["cx"], nd["cy"], tap_how(a)):
                die(f"[{s}] input tap failed")
            key = "text" if nd["text"] == sel else ("desc" if nd["desc"] == sel else ("id" if nd["id"] == sel else "text"))
            session_log({"api": api, "op": "tap", "by": key, "sel": sel, "scrolled": scrolls,
                         "text": nd["text"], "desc": nd["desc"], "id": nd["id"], "how": tap_how(a)})
            more = f" (matches {len(hit)}, took {min(a.nth, len(hit) - 1)})" if len(hit) > 1 else ""
            print(f"{api}: tap {fmt_node(nd, False)}{more}")
            return after_tap(api, s, a, nodes)
        time.sleep(1)
    near = similar_nodes(nodes, sel)[:8]
    print(f'{api}: not found "{sel}" (tries {a.retries}, scrolls {scrolls}). '
          + ("Similar:" if near else f"Nothing similar, {len(nodes)} nodes on screen — see adbm ui"))
    for nd in near:
        print("  " + fmt_node(nd, False))
    return 1


def node_label(n):
    """What a person calls a node: a switch by its row (its own text may be just ON/OFF)."""
    if "check" in n["flags"]:
        return n["desc"] or n.get("near") or n["text"] or n["id"]
    return n["text"] or n["desc"] or n["id"]


def node_keys(nodes):
    """Labels of the non-switch nodes: what appears and goes away."""
    return [node_label(n) for n in nodes if "check" not in n["flags"] and node_label(n)]


def switches(nodes):
    """[(label, on)] of checkable nodes in screen order: compared by position, labels may repeat."""
    return [(node_label(n), "on" in n["flags"]) for n in nodes if "check" in n["flags"]]


def screen_print(nodes):
    """A fingerprint of the screen for "did it change": labels and switch states."""
    return node_keys(nodes), switches(nodes)


def screen_change(before, after):
    """'+3 "A", "B", "C"; -1 "D"; "Wi-Fi" off' — texts that appeared and went away, switches that
    flipped, or 'screen unchanged'."""
    b, a = node_keys(before), node_keys(after)
    plus = [k for k in a if k not in b]
    minus = [k for k in b if k not in a]
    sb, sa = switches(before), switches(after)
    flipped = [f'"{trunc(lab, 30)}" {"on" if on else "off"}'
               for (lab, on), (_, was) in zip(sa, sb) if on != was] if len(sa) == len(sb) else []
    if not plus and not minus and not flipped:
        return "screen unchanged"

    def part(sign, ks):
        names = ", ".join(f'"{trunc(k, 30)}"' for k in ks[:4])
        return f"{sign}{len(ks)} {names}" + ("…" if len(ks) > 4 else "")
    parts = [part(sg, ks) for sg, ks in (("+", plus), ("-", minus)) if ks]
    if flipped:
        parts.append(", ".join(flipped[:4]) + (f" (+{len(flipped) - 4} switches)" if len(flipped) > 4 else ""))
    return "; ".join(parts)


def wait_for(serial, sel, timeout, gone=False, before=None):
    """Poll the tree until sel is on the screen (or gone). Returns (ok, nodes, hits).

    A failed dump (uiautomator busy during an animation) is retried until the timeout.
    With `before` (the screen before a tap) a text that was already there counts only after the screen changed.
    """
    t0 = time.time()
    nodes, hit = [], []
    stale = before is not None and bool(find_nodes(before, sel))
    while True:
        try:
            _, nodes = ui_snapshot(serial)
            hit = find_nodes(nodes, sel)
            changed = not stale or screen_print(nodes) != screen_print(before)
            if bool(hit) != gone and changed:
                return True, nodes, hit
        except SystemExit:
            pass
        if time.time() - t0 >= timeout:
            return False, nodes, hit
        time.sleep(0.5)


def match_kind(nd, sel):
    """How a node matched a selector, for save-flow: ('text'|'id', regex or id)."""
    if nd["id"] == sel or nd["rid"] == sel:
        return "id", nd["id"]
    if sel in (nd["text"], nd["desc"]):
        return "text", re.escape(sel)
    return "text", ".*" + re.escape(sel) + ".*"


def screen_brief(nodes, n=5):
    if not nodes:
        return "  (no UI tree: uiautomator did not answer)"
    return "\n".join("  " + fmt_node(nd, False) for nd in nodes[:n]) + (
        f"\n  … {len(nodes) - n} more — adbm ui" if len(nodes) > n else "")


def save_ui_cache(serial, nodes):
    os.makedirs(CACHE, exist_ok=True)
    json.dump(nodes, open(os.path.join(CACHE, f"ui-{serial}.json"), "w"), ensure_ascii=False)


def after_tap(api, s, a, before):
    """After a tap: --expect waits for a text, otherwise a short diff of the screen. Returns the exit code."""
    if a.expect:
        time.sleep(min(a.wait, 0.5))
        ok, nodes, hit = wait_for(s, a.expect, a.timeout, before=before)
        if ok:
            kind, val = match_kind(hit[0], a.expect)
            session_log({"api": api, "op": "wait", "by": kind, "value": val, "timeout": a.timeout})
        if ok:
            print(f'  ok "{a.expect}" · {fmt_node(hit[0], False)}')
            return 0
        print(f'  not found "{a.expect}" in {a.timeout:g} s; screen:\n' + screen_brief(nodes))
        return 1
    if a.wait:
        time.sleep(a.wait)
    if before is None or a.quiet:
        return 0
    try:
        _, nodes = ui_snapshot(s)
    except SystemExit:
        return 0
    print("  → " + screen_change(before, nodes))
    return 0


def cmd_wait(a):
    api, s = pick(a)[0]
    ok, nodes, hit = wait_for(s, a.text, a.timeout, a.gone)
    if ok:
        kind, val = ("text", re.escape(a.text)) if a.gone else match_kind(hit[0], a.text)
        session_log({"api": api, "op": "assert" if getattr(a, "is_assert", False) else "wait",
                     "by": kind, "value": val, "timeout": a.timeout, "gone": a.gone})
    if ok:
        print(f'{api}: gone "{a.text}"' if a.gone else f"{api}: found {fmt_node(hit[0], False)}"
              + (f" (matches {len(hit)})" if len(hit) > 1 else ""))
        return 0
    what = "still on screen" if a.gone else "not found"
    print(f'{api}: {what} "{a.text}" after {a.timeout:g} s; screen:\n' + screen_brief(nodes))
    return 1


def cmd_assert(a):
    a.timeout, a.gone, a.is_assert = 0, False, True
    return cmd_wait(a)


def cmd_launch(a):
    targets = pick(a, multi=True)

    def one(api, s):
        if a.stop or a.clear:
            adb(s, "shell", f"am force-stop {a.package}")
        if a.clear:
            adb(s, "shell", f"pm clear {a.package}")
        act = ashell(s, f"cmd package resolve-activity --brief -c android.intent.category.LAUNCHER {a.package}")
        act = act.splitlines()[-1].strip() if act else ""
        if "/" not in act:
            return f"error — {a.package} has no launcher activity"
        code, out, err = adb(s, "shell", f"am start -W -n {act}", timeout=60)
        session_log({"api": api, "op": "launch", "package": a.package, "clear": bool(a.clear)})
        return f"started {act}" if "Status: ok" in out or "Complete" in out else f"error — {(out + err).strip()[-200:]}"

    res = parallel(targets, one)
    for (api, s), r in zip(targets, res):
        print(f"{api}: {a.package} {r}")
    return 1 if any(r.startswith("error") for r in res) else 0


def cmd_type(a):
    api, s = pick(a)[0]
    if re.fullmatch(r"[\x20-\x7e]*", a.text):
        ok, out = adb_ok(s, "input text " + shlex.quote(a.text.replace(" ", "%s")))
    else:
        ok, out = type_maestro(s, a.text)
    if not ok:
        print(f"{api}: error — {trunc(out, 160)}")
        return 1
    session_log({"api": api, "op": "type", "text": a.text})
    print(f"{api}: typed {len(a.text)} characters" + ("" if re.fullmatch(r"[\x20-\x7e]*", a.text) else " via Maestro"))
    return 0


KEYS = {"back": 4, "home": 3, "enter": 66, "menu": 82, "recents": 187, "escape": 111, "del": 67, "tab": 61,
        "up": 19, "down": 20, "left": 21, "right": 22, "search": 84, "power": 26, "wake": 224, "sleep": 223,
        "volume-up": 24, "volume-down": 25, "notifications": 83}


def cmd_key(a):
    targets = pick(a, multi=True)
    if a.key == "hide-keyboard":
        def one(api, s):
            shown = "mInputShown=true" in ashell(s, "dumpsys input_method | grep mInputShown", timeout=15)
            return adb_ok(s, "input keyevent 4") if shown else (True, "")
    else:
        code = KEYS.get(a.key, a.key)
        if not str(code).isdigit() and not str(code).startswith("KEYCODE_"):
            die(f"unknown key {a.key}: {', '.join(KEYS)}, hide-keyboard, a number or KEYCODE_*")

        def one(api, s):
            return adb_ok(s, f"input keyevent {code}")
    res = parallel(targets, one)
    for api, _ in targets:
        session_log({"api": api, "op": "key", "key": a.key})
    bad = [f"{api}: error — {trunc(out, 120)}" for (api, _), (ok, out) in zip(targets, res) if not ok]
    print("\n".join(bad) or f"{','.join(str(t[0]) for t in targets)}: {a.key}")
    return 1 if bad else 0


def cmd_swipe(a):
    api, s = pick(a)[0]
    w, h = screen_size(s)
    d = {"up": (w // 2, int(h * .7), w // 2, int(h * .3)), "down": (w // 2, int(h * .3), w // 2, int(h * .7)),
         "left": (int(w * .8), h // 2, int(w * .2), h // 2), "right": (int(w * .2), h // 2, int(w * .8), h // 2)}
    if re.fullmatch(r"\d+,\d+,\d+,\d+", a.direction):
        d[a.direction] = tuple(map(int, a.direction.split(",")))
    if a.direction not in d:
        die("direction: up, down, left, right, or x0,y0,x1,y1")
    x0, y0, x1, y1 = d[a.direction]
    ok, out = adb_ok(s, f"input swipe {x0} {y0} {x1} {y1} {a.ms}")
    if not ok:
        print(f"{api}: error — {trunc(out, 160)}")
        return 1
    session_log({"api": api, "op": "swipe", "direction": a.direction, "points": [x0, y0, x1, y1], "screen": [w, h]})
    print(f"{api}: swipe {a.direction}")
    return 0


# ---------------------------------------------------------------- commands: device and app

def adb_ok(serial, cmd, timeout=60):
    """A shell command on the device → (ok, output). adb passes the exit code through since Android 7."""
    code, out, err = adb(serial, "shell", cmd, timeout=timeout)
    return code == 0, (out + err).strip()


def adb_error(out):
    """The useful line of a failed shell command: the Java exception message, else the last line."""
    m = re.search(r"Exception: (.+)", out)
    lines = [l for l in out.splitlines() if l.strip()]
    return trunc(m.group(1) if m else (lines[-1] if lines else "no answer"), 160)


def default_package():
    """The package of the installed build: the current run, else the project cache; "after" first."""
    for base in (current_run(create=False), project_cache()):
        try:
            b = json.load(open(os.path.join(base, "builds.json")))
        except Exception:
            continue
        for v in ("after", "before"):
            if b.get(v, {}).get("package"):
                return b[v]["package"]
    return None


def need_package(a):
    pkg = getattr(a, "package", None) or default_package()
    if not pkg:
        die("pass the package: no adbm install in this project yet")
    return pkg


def cmd_log(a):
    api, s = pick(a)[0]
    n = a.n
    if a.crash:
        out = adb(s, "logcat", "-b", "crash", "-d", "-v", "brief", timeout=30)[1]
        what = "crash buffer"
    else:
        cmd = ["logcat", "-d", "-v", "brief"]
        what = "all"
        pkg = None if a.all else (a.app or default_package())
        if a.tag:
            cmd += ["-s", f"{a.tag}:V"]
            what = f"tag {a.tag}"
        elif pkg:
            pid = ashell(s, f"pidof {pkg}", timeout=10).split()
            if pid:
                cmd.append(f"--pid={pid[0]}")
                what = f"{pkg} pid {pid[0]}"
            else:
                what = f"{pkg} is not running — lines that mention it"
        # -t counts lines before -s/--grep filtering: take the whole buffer when filtering, cut the tail here
        if not (a.tag or a.grep or pkg):
            cmd += ["-t", str(n)]
        out = adb(s, *cmd, timeout=30)[1]
        if pkg and "mention" in what:
            out = "\n".join(l for l in out.splitlines() if pkg in l)
    lines = [l for l in out.splitlines() if l.strip() and not l.startswith("--------- beginning of")]
    if a.grep:
        rx = re.compile(a.grep, re.I)
        lines = [l for l in lines if rx.search(l)]
    lines = lines[-n:]
    for l in lines:
        print(trunc(l, 220))
    print(f"# API {api} · {what} · {len(lines)} lines" + (f" · grep {a.grep}" if a.grep else ""))
    return 0


def cmd_open(a):
    targets = pick(a, multi=True)

    def one(api, s):
        cmd = f"am start -W -a android.intent.action.VIEW -d {shlex.quote(a.uri)}"
        if a.app:
            cmd += f" {shlex.quote(a.app)}"
        ok, out = adb_ok(s, cmd)
        bad = not ok or re.search(r"Error|unable to resolve|No Activity", out)
        if not bad:
            session_log({"api": api, "op": "open", "uri": a.uri})
        m = re.search(r"Activity: (\S+)", out)
        return (False, out.splitlines()[-1] if out else "no answer") if bad else (True, m.group(1) if m else "started")

    res = parallel(targets, one)
    for (api, _), (ok, msg) in zip(targets, res):
        print(f"{api}: " + (f"opened → {msg}" if ok else f"error — {msg}"))
    return 0 if all(ok for ok, _ in res) else 1


def full_perm(p):
    return p if "." in p else "android.permission." + p.upper()


def cmd_perm(a):
    targets = pick(a, multi=True)
    perms = [full_perm(p) for p in a.permissions]
    if a.action in ("grant", "revoke") and not perms:
        die("name the permissions: adbm perm <pkg> grant CAMERA POST_NOTIFICATIONS")

    def one(api, s):
        if a.action == "reset":
            dump = ashell(s, f"dumpsys package {a.package}", timeout=30)
            # runtime permissions only (install-time ones cannot be revoked), denied ones too: their user-fixed flag is what reset clears
            runtime = "\n".join(re.findall(r"runtime permissions:\n((?:\s+\S+: granted=.*\n?)+)", dump))
            names = perms or sorted(set(re.findall(r"([\w.]+\.permission\.[A-Z_]+): granted=", runtime)))
            errs = []
            for p in names:
                if "granted=true" in next((l for l in runtime.splitlines() if p + ":" in l), "granted=true"):
                    adb_ok(s, f"pm revoke {a.package} {p}")
                ok, out = adb_ok(s, f"pm clear-permission-flags {a.package} {p} user-set user-fixed")
                if not ok and "Unknown command" not in out:
                    errs.append(f"{p.split('.')[-1]}: {adb_error(out)}")
            return (not errs), f"reset {len(names)}" + (" · " + "; ".join(errs) if errs else "")
        errs = []
        for p in perms:
            ok, out = adb_ok(s, f"pm {a.action} {a.package} {p}")
            if not ok:
                errs.append(f"{p.split('.')[-1]}: {adb_error(out)}")
        return (not errs), (f"{a.action} {len(perms) - len(errs)} of {len(perms)}"
                            + (" · " + "; ".join(errs) if errs else ""))

    res = parallel(targets, one)
    for (api, _), (ok, msg) in zip(targets, res):
        print(f"{api}: {a.package} " + (msg if ok else f"error — {msg}"))
    return 0 if all(ok for ok, _ in res) else 1


def app_action(a, verb, cmd, check):
    targets = pick(a, multi=True)
    pkg = need_package(a)

    def one(api, s):
        if not ashell(s, f"pm path {shlex.quote(pkg)}", timeout=15).startswith("package:"):
            return False, f"{pkg} is not installed"
        ok, out = adb_ok(s, cmd.format(pkg=shlex.quote(pkg)), timeout=120)
        ok = ok and (check is None or check in out)
        if ok:
            session_log({"api": api, "op": verb, "package": pkg})
        return ok, out

    res = parallel(targets, one)
    for (api, _), (ok, out) in zip(targets, res):
        print(f"{api}: {pkg} " + (verb if ok else f"error — {adb_error(out)}"))
    return 0 if all(ok for ok, _ in res) else 1


def cmd_stop(a):
    return app_action(a, "stopped", "am force-stop {pkg}", None)


def cmd_clear(a):
    return app_action(a, "data cleared", "pm clear {pkg}", "Success")


def cmd_uninstall(a):
    return app_action(a, "uninstalled", "pm uninstall {pkg}", "Success")


def cmd_push(a):
    if not os.path.exists(a.local):
        die(f"no such file {a.local}")
    targets = pick(a, multi=True)
    res = parallel(targets, lambda api, s: adb(s, "push", a.local, a.remote, timeout=300))
    for (api, _), (code, out, err) in zip(targets, res):
        print(f"{api}: " + (f"{a.local} → {a.remote}" if code == 0 else f"error — {(out + err).strip()[-160:]}"))
    return 0 if all(r[0] == 0 for r in res) else 1


def cmd_pull(a):
    api, s = pick(a)[0]
    dest = a.local or os.path.join(scratch(), "pull", os.path.basename(a.remote.rstrip("/")))
    os.makedirs(os.path.dirname(os.path.abspath(dest)), exist_ok=True)
    code, out, err = adb(s, "pull", a.remote, dest, timeout=300)
    if code != 0:
        print(f"{api}: error — {(out + err).strip()[-160:]}")
        return 1
    size = sum(os.path.getsize(os.path.join(d, f)) for d, _, fs in os.walk(dest) for f in fs) \
        if os.path.isdir(dest) else os.path.getsize(dest)
    print(f"{api}: {a.remote} → {rel(dest)} ({human_size(size)})")
    return 0


def cmd_rotate(a):
    targets = pick(a, multi=True)
    if a.to == "auto":
        cmds = ["settings put system accelerometer_rotation 1"]
    else:
        cmds = ["settings put system accelerometer_rotation 0",
                f"settings put system user_rotation {0 if a.to == 'portrait' else 1}"]
    res = parallel(targets, lambda api, s: adb_ok(s, "; ".join(cmds)))
    for (api, _), (ok, out) in zip(targets, res):
        print(f"{api}: " + (f"rotation {a.to}" if ok else f"error — {trunc(out, 160)}"))
    return 0 if all(ok for ok, _ in res) else 1


def cmd_clear_field(a):
    api, s = pick(a)[0]
    _, nodes = ui_snapshot(s)
    foc = next((n for n in nodes if "focus" in n["flags"]), None)
    if not foc:
        print(f"{api}: no focused field — tap the field first")
        return 1
    n = len(foc["text"]) + 1
    # n × DEL and n × FORWARD_DEL clear the field wherever the cursor is, on every API level, unlike Ctrl+A
    codes = ["67"] * n + ["112"] * n
    ok, out = adb_ok(s, "; ".join("input keyevent " + " ".join(codes[i:i + 40]) for i in range(0, len(codes), 40)))
    if ok:
        session_log({"api": api, "op": "clear_field", "n": n})
    print(f"{api}: " + (f'cleared {fmt_node(foc, False)}' if ok else f"error — {trunc(out, 160)}"))
    return 0 if ok else 1


def type_maestro(serial, text):
    """Non-ASCII text: `input text` cannot type it, Maestro `inputText` can (checked on API 28, 33, 35)."""
    mae = maestro_bin()
    if not mae:
        die("non-ASCII text is typed through Maestro, and it is not installed — adbm setup --maestro --yes")
    focus = ashell(serial, "dumpsys window | grep -m1 mCurrentFocus", timeout=15)
    m = re.search(r"\s([\w.]+)/", focus)
    d = tempfile.mkdtemp(prefix="adbm-type-")
    flow = os.path.join(d, "type.yaml")
    try:
        # appId is required by the flow format; without launchApp Maestro does not touch the app
        with open(flow, "w") as f:
            f.write(f"appId: {m.group(1) if m else 'android'}\n---\n"
                    f"- inputText: {json.dumps(text, ensure_ascii=False)}\n")
        code, out, err = sh([mae, "--device", serial, "test", flow, "--no-ansi"], timeout=180)
    finally:
        shutil.rmtree(d, ignore_errors=True)
    return code == 0, "" if code == 0 else maestro_failure(out + err)


# ---------------------------------------------------------------- commands: frames

def frame_path(run, api, version, group, name):
    parts = [run, f"api{api}", version] + ([g for g in group.split("/") if g] if group else [])
    d = os.path.join(*parts)
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, slugify_name(name) + ".png")


def slugify_name(n):
    n = n[:-4] if n.lower().endswith(".png") else n
    return re.sub(r"[^\w\-.]+", "-", n, flags=re.U).strip("-") or "frame"


def default_as(run, a):
    if getattr(a, "as_", None):
        return a.as_
    p = os.path.join(run, ".as")
    return open(p).read().strip() if os.path.exists(p) else "after"


def frames_home(a):
    """Where shot/record write: (folder, build version, in a run). Only `new` and `run` start a run;
    outside one, frames go to the project's cache and the build comes from the project's last install."""
    run = current_run(create=False)
    if run:
        return run, default_as(run, a), True
    return os.path.join(project_cache(), "shots"), default_as(project_cache(), a), False


def cmd_shot(a):
    targets = pick(a, multi=True)
    run, version, in_run = frames_home(a)

    def one(api, s):
        data = screencap(s)
        p = frame_path(run, api, version, a.group, a.name)
        open(p, "wb").write(data)
        if frame_problem(p) == "black":
            print(f"{api}: {SECURE_HINT}", file=sys.stderr)
        if not a.no_ui:
            try:
                _, nodes = ui_snapshot(s)
                open(p[:-4] + ".ui.txt", "w").write(tree_text(nodes, limit=None))
            except SystemExit:
                pass
        return p

    paths = parallel(targets, one)
    if in_run:
        stats_add(run, frames=len(paths))
    for api, _ in targets:
        session_log({"api": api, "op": "shot", "name": a.name, "group": a.group or ""})
    for (api, _), p in zip(targets, paths):
        print(f"{api}: {rel(p)}")
    if not in_run:
        print(NO_RUN_HINT)
    return 0


def cmd_look(a):
    Image = pil()
    import io
    api, s = pick(a)[0]
    run = scratch()
    im = Image.open(io.BytesIO(screencap(s))).convert("RGB")
    W, H = im.size
    if a.crop:
        x0, y0, x1, y1 = parse_crop(a.crop, W, H)
        im = im.crop((x0, y0, x1, y1))
        scale = 1.0
        if max(im.size) > 1200:
            scale = 1200 / max(im.size)
            im = im.resize((int(im.width * scale), int(im.height * scale)), Image.LANCZOS)
        note = f"crop {x0},{y0}-{x1},{y1}"
    else:
        tw = LOOK_W["small" if a.small else "normal"]
        scale = tw / W
        im = im.resize((tw, int(H * scale)), Image.LANCZOS)
        note = "frame"
    d = os.path.join(run, "look")
    os.makedirs(d, exist_ok=True)
    n = len(glob.glob(os.path.join(d, "*.png"))) + 1
    p = os.path.join(d, f"{n:03d}-api{api}.png")
    im.save(p, optimize=True)
    tok = -(-im.width // 28) * -(-im.height // 28)
    if run != CACHE:
        stats_add(run, context_images=1, context_image_tokens=tok)
    warn = " · over 1000 tokens: narrow the crop" if a.crop and tok > 1000 else ""
    print(f"{rel(p)}  {im.width}x{im.height} · {note} · scale={scale:.3f} (screen = image / scale) · ~{tok} tokens{warn}")
    return 0


def parse_crop(s, w, h):
    """'x0,y0,x1,y1' → a box clamped to w × h; die on a malformed or empty box."""
    try:
        x0, y0, x1, y1 = map(int, s.split(","))
    except ValueError:
        die(f"--crop wants x0,y0,x1,y1 in pixels: {s}")
    box = (max(0, x0), max(0, y0), min(w, x1), min(h, y1))
    if box[2] <= box[0] or box[3] <= box[1]:
        die(f"--crop {s} is empty inside a {w}x{h} frame")
    return box


def frame_run(path):
    """The run folder a frame belongs to: build/adbm/<run>/…, else None."""
    d = os.path.dirname(os.path.abspath(path))
    while d != os.path.dirname(d):
        parent = os.path.dirname(d)
        if os.path.basename(parent) == "adbm" and os.path.basename(os.path.dirname(parent)) == "build":
            return d
        d = parent
    return None


def cmd_thumb(a):
    Image = pil()
    if not os.path.exists(a.frame):
        die(f"no such file {a.frame}")
    if frame_problem(a.frame, check_black=False):
        die(f"not a PNG or empty: {a.frame}")
    run = frame_run(a.frame) or CACHE
    im = Image.open(a.frame).convert("RGB")
    W, H = im.size
    if a.crop:
        x0, y0, x1, y1 = parse_crop(a.crop, W, H)
        im = im.crop((x0, y0, x1, y1))
        note = f"crop {x0},{y0}-{x1},{y1}"
    else:
        note = "frame"
    scale = min(1.0, a.w / im.width, (a.w * 2.5) / im.height)
    if scale < 1:
        im = im.resize((max(1, int(im.width * scale)), max(1, int(im.height * scale))), Image.LANCZOS)
    d = os.path.join(run, "look")
    os.makedirs(d, exist_ok=True)
    n = len(glob.glob(os.path.join(d, "*.png"))) + 1
    p = os.path.join(d, f"{n:03d}-thumb-{slugify_name(os.path.basename(a.frame))}.png")
    im.save(p, optimize=True)
    tok = -(-im.width // 28) * -(-im.height // 28)
    if run != CACHE:
        stats_add(run, thumb_images=1, thumb_image_tokens=tok)
    print(f"{rel(p)}  {im.width}x{im.height} · {note} · scale={scale:.3f} (frame = image / scale) · ~{tok} tokens")
    return 0


def annotate_tap(api, s, n, a):
    acli = android_cli()
    if not acli:
        die("no Android CLI — `adbm setup --android-cli --yes`, or tap by text from `adbm ui`")
    ref = os.path.join(CACHE, f"annotate-{s}.txt")
    shot = open(ref).read().strip() if os.path.exists(ref) else ""
    if not os.path.exists(shot):
        die("no fresh `adbm annotate` for this device")
    code, out, err = sh([acli, "--no-metrics", "screen", "resolve", "--screenshot", shot, "--string", f"#{n}"],
                        timeout=60)
    m = re.search(r"(\d+)\s+(\d+)\s*$", out.strip())
    if code != 0 or not m:
        die(f"android screen resolve: {(out + err).strip()[-300:]}")
    x, y = map(int, m.groups())
    if not tap_xy(s, x, y, tap_how(a)):
        die(f"[{s}] input tap failed")
    session_log({"api": api, "op": "tap_xy", "x": x, "y": y, "screen": screen_size(s), "note": f"annotate #{n}"})
    print(f"{api}: tap #{n} → {x},{y}")
    return after_tap(api, s, a, None)


def cmd_annotate(a):
    Image = pil()
    acli = android_cli()
    if not acli:
        die("no Android CLI — `adbm setup --android-cli --yes`. Without it: `adbm ui` + `adbm tap \"text\"`")
    api, s = pick(a)[0]
    run = scratch()
    d = os.path.join(run, "look")
    os.makedirs(d, exist_ok=True)
    raw = os.path.join(run, "logs", f"annotate-api{api}-{int(time.time())}.png")
    code, out, err = sh([acli, "--no-metrics", "screen", "capture", "--annotate", "--device", s, "--output", raw],
                        timeout=120)
    os.makedirs(CACHE, exist_ok=True)
    open(os.path.join(CACHE, f"annotate-{s}.txt"), "w").write(raw)
    if code != 0 or not os.path.exists(raw):
        log = os.path.join(run, "logs", f"annotate-api{api}.log")
        open(log, "w").write(out + "\n" + err)
        die(f"android screen capture --annotate failed, log {rel(log)}")
    im = Image.open(raw).convert("RGB")
    scale = 540 / im.width
    im = im.resize((540, int(im.height * scale)), Image.LANCZOS)
    n = len(glob.glob(os.path.join(d, "*.png"))) + 1
    p = os.path.join(d, f"{n:03d}-api{api}-annotate.png")
    im.save(p, optimize=True)
    tok = -(-im.width // 28) * -(-im.height // 28)
    if run != CACHE:
        stats_add(run, context_images=1, context_image_tokens=tok)
    print(f"{rel(p)}  540x{im.height} · ~{tok} tokens · tap: adbm tap --api {api} '#N'")
    return 0


# ---------------------------------------------------------------- run: Maestro

def parse_matrix(items):
    """['theme=light,dark', 'nav=threebutton,gestural'] → [{'theme': 'light', 'nav': ...}, ...]"""
    axes = []
    for it in items or []:
        for part in it.split():
            k, _, v = part.partition("=")
            if k not in ("theme", "nav", "font_scale", "font", "locale"):
                die(f"matrix axis not supported: {k} (theme, nav, font, locale)")
            axes.append(("font_scale" if k == "font" else k, [x for x in v.split(",") if x]))
    cells = [{}]
    for k, vals in axes:
        cells = [{**c, k: v} for c in cells for v in vals]
    return cells, [k for k, _ in axes]


def cell_group(cell, keys, extra=""):
    parts = [str(cell[k]) for k in keys]
    if extra:
        parts.append(extra)
    return "/".join(parts)


def run_watched(cmd, stall, total):
    """Run with two watchdogs: no output for longer than stall s, or longer than total s overall — kill the process group.

    Returns (code, output, reason): reason is None, 'stall' or 'timeout'.
    """
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
    lines, last = [], [time.time()]
    startup = max(stall, 120)  # JVM start and driver install print nothing

    def reader():
        for raw in iter(p.stdout.readline, b""):
            lines.append(raw.decode("utf-8", "replace"))
            last[0] = time.time()

    th = threading.Thread(target=reader, daemon=True)
    th.start()
    t0, reason = time.time(), None
    while p.poll() is None:
        time.sleep(1)
        now = time.time()
        if now - last[0] > (stall if lines else startup):
            reason = "stall"
        elif now - t0 > total:
            reason = "timeout"
        if reason:
            # maestro is a shell wrapper around a JVM: kill the whole group, or java outlives the wrapper;
            # the wrapper may exit on TERM while java lingers, so KILL the group after a grace period anyway
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                p.wait(5)
            except subprocess.TimeoutExpired:
                pass
            time.sleep(1)
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            p.wait()
            break
    th.join(5)
    return p.returncode, "".join(lines), reason


def flow_timeouts(flow, seen=None):
    """All `timeout:` values (ms) in a flow and in flows it includes via runFlow."""
    seen = seen if seen is not None else set()
    flow = os.path.abspath(flow)
    if flow in seen or not os.path.exists(flow):
        return []
    seen.add(flow)
    text = open(flow).read()
    res = [int(x) for x in re.findall(r"^\s*timeout:\s*(\d+)", text, re.M)]
    for inc in re.findall(r"^\s*-?\s*(?:runFlow|file):\s*['\"]?([^\s'\"{}]+\.ya?ml)", text, re.M):
        res += flow_timeouts(os.path.join(os.path.dirname(flow), inc), seen)
    return res


def watch_limits(flow, api_list, stall, timeout):
    """Watchdog limits: from flags, otherwise from the flow and run history. Returns (stall, timeout, explanation)."""
    notes = []
    if stall is None:
        waits = flow_timeouts(flow)
        longest = max(waits) // 1000 if waits else 0
        stall = max(45, longest + 20)
        notes.append(f"silence {stall} s = longest wait in the flow {longest} s + 20, at least 45")
    else:
        notes.append(f"silence {stall} s (flag)")
    if timeout is None:
        hist = load_durations().get(os.path.abspath(flow), {})
        last = [hist[str(a)] for a in api_list if str(a) in hist]
        if last:
            timeout = max(90, int(2 * max(last)))
            notes.append(f"cell {timeout} s = 2 × last run {max(last):.0f} s, at least 90")
        else:
            timeout = 600
            notes.append("cell 600 s (no run history)")
    else:
        notes.append(f"cell {timeout} s (flag)")
    return stall, timeout, "watchdog: " + "; ".join(notes)


def load_durations():
    try:
        return json.load(open(os.path.join(CACHE, "durations.json")))
    except Exception:
        return {}


def save_duration(flow, api, seconds):
    with _lock:
        d = load_durations()
        d.setdefault(os.path.abspath(flow), {})[str(api)] = round(seconds, 1)
        os.makedirs(CACHE, exist_ok=True)
        json.dump(d, open(os.path.join(CACHE, "durations.json"), "w"), indent=1)


def device_diagnosis(serial, nodes):
    """What happened to the device: offline, an ANR/crash window, the current window."""
    code, out, _ = sh([adb_bin(), "-s", serial, "get-state"], timeout=10)
    if code != 0 or out.strip() != "device":
        return f"device {serial} is not responding ({out.strip() or 'no answer'}) — adbm devices, restart the emulator"
    # crash and ANR dialogs are recognised by their button ids (aerr_close, aerr_wait…): ids do not depend on the device language
    if any(n["rid"].startswith("android:id/aerr_") for n in nodes):
        title = next((n["text"] for n in nodes if n["rid"] == "android:id/alertTitle"), "")
        return f"system error dialog on screen: \"{trunc(title, 50)}\" — the app hung or crashed"
    focus = ashell(serial, "dumpsys window | grep -m1 mCurrentFocus", timeout=15)
    m = re.search(r"\S+/\S+(?=})", focus)
    return f"focus: {m.group(0) if m else focus.strip()[:80]}"


def maestro_failure(log):
    lines = log.splitlines()
    bad = [l.strip() for l in lines if re.search(r"FAILED|not found|Assertion|Exception|Error:", l)]
    msg = bad[-1] if bad else (lines[-1].strip() if lines else "?")
    return msg.split(". Check the UI hierarchy")[0][:200]


def cmd_run(a):
    mae = maestro_bin()
    if not mae:
        die("no Maestro — `adbm setup --maestro --yes`")
    flow = os.path.abspath(a.flow)
    if not os.path.exists(flow):
        die(f"no such flow: {a.flow}")
    targets = pick(a, multi=True)
    slug = os.path.splitext(os.path.basename(flow))[0]
    run = new_run(slug) if a.new else current_run(slug=slug)
    version = default_as(run, a)
    cells, keys = parse_matrix(a.matrix)
    app = min_sdk = None
    try:
        build = json.load(open(os.path.join(run, "builds.json"))).get(version, {})
        app, min_sdk = build.get("package"), build.get("min_sdk")
    except Exception:
        pass
    m = re.search(r"^appId:\s*(\S+)", open(flow).read(), re.M)
    app = app or (m.group(1) if m else None)
    envs = []
    for e in a.env or []:
        envs += ["-e", e]

    def one(api, s):
        res = []
        if min_sdk and api < min_sdk:
            return [(cell, "skip", f"build {version} has minSdk {min_sdk}", 0) for cell in cells]
        if app and not ashell(s, f"pm path {app}", timeout=15).startswith("package:"):
            return [(cell, "fail", f"{app} is not installed on API {api} — adbm install <apk> --as {version} --api {api}",
                     0, None) for cell in cells]
        pinned = load_pinned(api, s)
        applied = None
        for cell in cells:
            if cell.get("nav") == "gestural" and api < 29:
                res.append((cell, "skip", f"no gestural on API {api}", 0))
                continue
            if cell.get("locale") and (api < 33 or not app):
                res.append((cell, "skip", f"locale needs API 33+ and the app package (API {api}, package {app or 'none'})", 0))
                continue
            group = cell_group(cell, keys, a.group or "")
            tag = f"api{api}" + ("-" + group.replace("/", "-") if group else "")
            # axes outside the matrix: what `adbm prep` set by hand, else the defaults — never the previous cell
            axes = {**DEFAULT_AXES, **pinned, **{k: v for k, v in cell.items() if k in AXES}}
            want = (axes["theme"], axes["nav"], axes["font_scale"], cell.get("locale"))
            if want != applied:
                ok, why = prep_device(api, s, axes["theme"], axes["nav"], axes["font_scale"], cell.get("locale"), app)
                if not ok:
                    applied = None
                    res.append((cell, "fail", f"prep: {why}", 0, None))
                    continue
                applied = want
            dest = os.path.join(run, f"api{api}", version, *([g for g in group.split("/") if g]))
            stale = [p for p in glob.glob(os.path.join(dest, "*.png"))]
            for p in stale:
                os.remove(p)
            out = tempfile.mkdtemp(prefix="adbm-maestro-")
            log_p = os.path.join(run, "logs", f"run-{version}-{tag}.log")
            cmd = [mae, "--device", s, "test", flow, "--test-output-dir", out, "--no-ansi"] + envs
            t0 = time.time()
            code, log, hung = run_watched(cmd, stall, timeout)
            open(log_p, "w").write(" ".join(shlex.quote(c) for c in cmd) + "\n\n" + log)
            shots = sorted(glob.glob(os.path.join(out, "**", "takeScreenshot", "*.png"), recursive=True))
            bad = {"broken": [], "black": []}
            kept = []
            for p in shots:
                prob = frame_problem(p)
                if prob == "broken":
                    bad["broken"].append(os.path.basename(p))
                    continue
                dst = frame_path(run, api, version, group, os.path.basename(p))
                shutil.move(p, dst)
                kept.append(dst)
                if prob == "black":
                    bad["black"].append(os.path.basename(p))
            shots = kept
            if code != 0 or hung:
                crash = adb(s, "logcat", "-b", "crash", "-d", "-t", "60")[1]
                if crash.strip():
                    open(os.path.join(run, "logs", f"crash-{tag}.txt"), "w").write(crash)
                nodes = []
                try:
                    _, nodes = ui_snapshot(s)
                    open(os.path.join(run, "logs", f"ui-fail-{tag}.txt"), "w").write(tree_text(nodes))
                except SystemExit:
                    pass
                steps = [l.strip() for l in log.splitlines() if l.strip()]
                if hung:
                    limit = f"no output for {stall} s" if hung == "stall" else f"longer than {timeout} s"
                    why = f"HUNG ({limit}) after step \"{trunc(steps[-1], 60) if steps else '—'}\""
                else:
                    why = maestro_failure(log)
                why += f" · {device_diagnosis(s, nodes)} · screen: logs/ui-fail-{tag}.txt"
                if "Screenshot returned null" in log:
                    why += " · " + SECURE_HINT
                if crash.strip():
                    why += " · crash in logs/crash-" + tag + ".txt"
                res.append((cell, "fail", why, len(shots), log_p))
            elif bad["broken"] or bad["black"]:
                parts = []
                if bad["broken"]:
                    parts.append(f"empty frames dropped {len(bad['broken'])}: {', '.join(bad['broken'][:3])}")
                if bad["black"]:
                    parts.append(f"black frames {len(bad['black'])} of {len(shots)}")
                res.append((cell, "fail", " · ".join(parts) + " · " + SECURE_HINT, len(shots), log_p))
            else:
                save_duration(flow, api, time.time() - t0)
                res.append((cell, "ok", f"{time.time() - t0:.0f} s", len(shots), log_p))
            shutil.rmtree(out, ignore_errors=True)
        return res

    flows_dir = os.path.join(project_root(), ".adbm", "flows")
    if not flow.startswith(flows_dir + os.sep):
        print(f"warning: the flow is outside {rel(flows_dir)}/ — keep it there to reuse it: adbm flow new <slug>")
    stall, timeout, why = watch_limits(flow, [t[0] for t in targets], a.stall, a.timeout)
    print(f"run {rel(run)} · {version} · {os.path.basename(flow)} · API {','.join(str(t[0]) for t in targets)}"
          + (f" · cells {len(cells)}" if len(cells) > 1 else ""))
    print(why)
    results = parallel(targets, one)
    total = fails = 0
    for (api, _), res in zip(targets, results):
        for r in res:
            cell, st, why, n = r[:4]
            label = f"{api}" + (" " + cell_group(cell, keys) if keys else "")
            total += n
            if st == "ok":
                print(f"{label}: ok, frames {n}, {why}")
            elif st == "skip":
                print(f"{label}: skipped — {why}")
            else:
                fails += 1
                print(f"{label}: FAILED, frames {n} — {why}" + (f" → {rel(r[4])}" if r[4] else ""))
    stats_add(run, frames=total)
    print(f"total frames {total}" + (f", failures {fails}" if fails else "") + " · next: adbm diff, adbm board")
    return 1 if fails else 0


# ---------------------------------------------------------------- run scan

def scan_run(run):
    """Run frames → {key: {api: {'before': path, 'after': path}}}.

    Understands two layouts:
      api35/after/<group…>/<name>.png         (adbm)
      api35/<group…>/<name>-after.png         (old manual runs)
    """
    frames = {}
    for p in sorted(glob.glob(os.path.join(run, "api*", "**", "*.png"), recursive=True)):
        parts = os.path.relpath(p, run).split(os.sep)
        m = re.fullmatch(r"api(\d+)", parts[0])
        if not m:
            continue
        if frame_problem(p, check_black=False) == "broken":
            print(f"skipping broken frame: {os.path.relpath(p, run)}", file=sys.stderr)
            continue
        api = int(m.group(1))
        name = os.path.splitext(parts[-1])[0]
        if len(parts) >= 3 and parts[1] in VERSIONS:
            version, group = parts[1], "/".join(parts[2:-1])
        else:
            mm = re.fullmatch(r"(.+)-(before|after)", name)
            if not mm:
                continue
            name, version, group = mm.group(1), mm.group(2), "/".join(parts[1:-1])
        key = (group, name)
        frames.setdefault(key, {}).setdefault(api, {})[version] = p
    return frames


def frame_sort_key(k):
    g, n = k
    m = re.match(r"(\d+)", n)
    return (g, int(m.group(1)) if m else 10 ** 6, n)


# ---------------------------------------------------------------- diff

def dhash(im, size=16):
    pil()
    g = im.convert("L").resize((size + 1, size))
    px = g.tobytes()
    bits = 0
    for y in range(size):
        for x in range(size):
            bits = (bits << 1) | (px[y * (size + 1) + x] > px[y * (size + 1) + x + 1])
    return bits


def ui_lines_to_map(path):
    res = {}
    if not os.path.exists(path):
        return None
    for line in open(path):
        m = re.match(r'\[\d+\] (\S+)(?: "([^"]*)")?(?: desc="([^"]*)")?(?: id=(\S+))? @(\d+),(\d+)', line)
        if m:
            cls, text, desc, rid, x, y = m.groups()
            key = text or desc or rid
            if key and key not in res:
                res[key] = (int(x), int(y))
    return res


def ui_diff(bp, ap):
    b = ui_lines_to_map(bp[:-4] + ".ui.txt")
    a = ui_lines_to_map(ap[:-4] + ".ui.txt")
    if b is None or a is None:
        return []
    out = []
    for k in b:
        if k in a:
            dx, dy = a[k][0] - b[k][0], a[k][1] - b[k][1]
            if abs(dx) >= 4 or abs(dy) >= 4:
                d = []
                if dy:
                    d.append(f"{'↓' if dy > 0 else '↑'}{abs(dy)}")
                if dx:
                    d.append(f"{'→' if dx > 0 else '←'}{abs(dx)}")
                out.append(f'"{trunc(k, 30)}" {" ".join(d)} px')
        else:
            out.append(f'"{trunc(k, 30)}" gone')
    out += [f'"{trunc(k, 30)}" appeared' for k in a if k not in b]
    return out


def px_diff(b, a, mask_top):
    """Pixel diff of two RGB images of one size → (mask, changed, pct, bbox, top share).

    The top strip (status bar) is masked out of pct and bbox; its own changed share, without
    the clock, comes separately.
    """
    from PIL import ImageChops
    m = int(b.height * mask_top)
    d = ImageChops.difference(b, a).convert("L").point(lambda v: 255 if v > 24 else 0)
    top = 0.0
    if m:
        # the clock sits in the left part: without demo mode it ticks between captures, so only the icons count
        x = int(b.width * CLOCK_W)
        top = d.crop((x, 0, b.width, m)).histogram()[255] / ((b.width - x) * m)
        d.paste(0, (0, 0, b.width, m))
    changed = d.histogram()[255]
    pct = 100.0 * changed / (b.width * (b.height - m))
    return d, changed, pct, d.getbbox(), top


def pair_crop(b, a, box, out, max_w=DIFF_W, max_h=800, pad=16, min_scale=0.5):
    """"before | after" of one area: side by side if the area is tall, stacked if wide.

    Written only if the area fits at scale ≥ min_scale, otherwise the downscaled diff shows it as well.
    """
    Image = pil()
    x0, y0, x1, y1 = box
    box = (max(0, x0 - pad), max(0, y0 - pad), min(b.width, x1 + pad), min(b.height, y1 + pad))
    cb, ca = b.crop(box), a.crop(box)
    cw, ch = cb.size
    gap = 4
    side = ch > cw
    W, H = (2 * cw + gap, ch) if side else (cw, 2 * ch + gap)
    s = min(1.0, max_w / W, max_h / H)
    if s < min_scale:
        return False
    sheet = Image.new("RGB", (W, H), (230, 30, 30))
    sheet.paste(cb, (0, 0))
    sheet.paste(ca, (cw + gap, 0) if side else (0, ch + gap))
    if s < 1:
        sheet = sheet.resize((int(W * s), int(H * s)), Image.LANCZOS)
    sheet.save(out, optimize=True)
    return True


TOP_NOISE = 0.002
CLOCK_W = 0.3


def diff_pair(bp, ap, outp, mask_top, full=False):
    """Diff of one pair; for a changed pair writes outp (DIFF_W px), outp.crop.png and outp.top.png when useful."""
    Image = pil()
    b = Image.open(bp).convert("RGB")
    a = Image.open(ap).convert("RGB")
    note = ""
    if a.size != b.size:
        note = f"size {b.size[0]}x{b.size[1]} → {a.size[0]}x{a.size[1]}"
        a = a.resize(b.size)
    d, changed, pct, bbox, top = px_diff(b, a, mask_top)
    same_hash = dhash(b) == dhash(a)
    # dHash matches and less than 0.1% of pixels changed — antialiasing noise, not a change
    content_same = changed == 0 or (same_hash and pct < 0.1)
    top_changed = top > TOP_NOISE
    files = {}
    if not (content_same and not top_changed) and outp:
        os.makedirs(os.path.dirname(outp), exist_ok=True)
        base = Image.blend(a, Image.new("RGB", a.size, "white"), 0.6)
        base.paste(Image.new("RGB", a.size, (230, 30, 30)), (0, 0), d)
        if bbox:
            from PIL import ImageDraw
            ImageDraw.Draw(base).rectangle(bbox, outline=(230, 30, 30), width=max(3, b.width // 200))
        if not full and base.width > DIFF_W:
            base = base.resize((DIFF_W, int(base.height * DIFF_W / base.width)), Image.LANCZOS)
        base.save(outp, optimize=True)
        files["diff"] = outp
        if bbox and not content_same and pair_crop(b, a, bbox, outp[:-4] + ".crop.png"):
            files["crop"] = outp[:-4] + ".crop.png"
        if top_changed and pair_crop(b, a, (0, 0, b.width, int(b.height * mask_top)), outp[:-4] + ".top.png",
                                     pad=0, min_scale=0):
            files["top"] = outp[:-4] + ".top.png"
    return {"pct": round(pct, 2), "bbox": list(bbox) if bbox else None,
            "same": content_same and not top_changed, "content_same": content_same, "status_bar": top_changed,
            "phash_same": same_hash, "note": note, "files": files}


def frames_alike(p, q, mask_top):
    """Two frames look the same: one size, < 0.5% of pixels differ, status bar too."""
    Image = pil()
    with Image.open(p) as x, Image.open(q) as y:
        if x.size != y.size:
            return False
        _, _, pct, _, top = px_diff(x.convert("RGB"), y.convert("RGB"), mask_top)
    return pct < 0.5 and top < 0.005


def same_change(r, o):
    """Two changed pairs from different API levels changed the same way: percent, area size, status bar, UI diff.

    Frames of different API levels differ by layout, so the change is compared, not the pixels.
    """
    if r["same"] or o["same"] or r["status_bar"] != o["status_bar"] or r["ui"] != o["ui"] or r["note"] or o["note"]:
        return False
    if abs(r["pct"] - o["pct"]) > 0.3:
        return False
    if not r["bbox"] or not o["bbox"]:
        return r["bbox"] == o["bbox"]
    (w1, h1), (w2, h2) = [(b[2] - b[0], b[3] - b[1]) for b in (r["bbox"], o["bbox"])]
    return abs(w1 - w2) <= 0.02 * max(w1, w2) + 4 and abs(h1 - h2) <= 0.02 * max(h1, h2) + 4


def cmd_diff(a):
    run = resolve_run(a.run, create=False)
    if not run:
        die("no current run")
    frames = scan_run(run)
    out_dir = os.path.join(run, "diff")
    for old in glob.glob(os.path.join(out_dir, "**", "*.png"), recursive=True) + [os.path.join(out_dir, "diff.json")]:
        with contextlib.suppress(FileNotFoundError):
            os.remove(old)
    if not any("after" in v for k in frames for v in frames[k].values()):
        print("no after frames — capture them with adbm run or adbm shot" +
              (" (only before frames so far)" if frames else ""))
        return 1
    has_pairs = any(len(v) == 2 for k in frames for v in frames[k].values())
    res, lines = [], []

    def single(api, group, name, label, missing, twin=None):
        res.append({"api": api, "group": group, "name": name, "missing": missing, "same": None,
                    "pct": None, "diff": None, "ui": [], "same_as_api": twin})
        if twin:
            lines.append(f"{label}: ≈ api{twin}")
        elif missing == "before":
            lines.append(f"{label}: " + ("no before frame — judge it by the checklist" if has_pairs else "after only"))
        else:
            lines.append(f"{label}: no after frame")

    for key in sorted(frames, key=frame_sort_key):
        group, name = key
        done = {}
        for api in sorted(frames[key]):
            v = frames[key][api]
            label = f"api{api}/" + (group + "/" if group else "") + name
            if "after" not in v:
                single(api, group, name, label, "after")
                continue
            if "before" not in v:
                # after-only frames: a twin is a frame that looks the same on an earlier API level
                twin = None if has_pairs else next(
                    (o for o in sorted(done) if done[o] is None
                     and frames_alike(frames[key][o]["after"], v["after"], a.mask_top)), None)
                if not has_pairs:
                    done[api] = twin
                single(api, group, name, label, "before", twin)
                continue
            outp = os.path.join(out_dir, f"api{api}", *(group.split("/") if group else []), name + ".png")
            r = diff_pair(v["before"], v["after"], outp, a.mask_top, a.full)
            files = r.pop("files")
            r["ui"] = ui_diff(v["before"], v["after"])
            twin = next((o for o in sorted(done) if done[o][0] is None and same_change(r, done[o][1])), None)
            done[api] = (twin, r)
            if twin:
                for f in files.values():
                    with contextlib.suppress(FileNotFoundError):
                        os.remove(f)
                files = {}
            r.update({"api": api, "group": group, "name": name, "same_as_api": twin, "missing": None,
                      "diff": os.path.relpath(files["diff"], run) if "diff" in files else None,
                      "crop": os.path.relpath(files["crop"], run) if "crop" in files else None,
                      "top": os.path.relpath(files["top"], run) if "top" in files else None})
            res.append(r)
            if r["same"]:
                s = "unchanged"
            elif twin:
                s = f"≈ api{twin}: the same change"
            elif r["content_same"]:
                s = "status bar only"
            else:
                bb = r["bbox"]
                s = f"{r['pct']:.1f}% @{bb[0]},{bb[1]}-{bb[2]},{bb[3]}"
                if r["status_bar"]:
                    s += " · status bar differs"
                if r["phash_same"]:
                    s += " (looks the same)"
            if r["note"]:
                s += " · " + r["note"]
            if r["ui"] and not twin:
                s += " · " + "; ".join(r["ui"][:3]) + (f" (+{len(r['ui']) - 3})" if len(r["ui"]) > 3 else "")
            lines.append(f"{label}: {s}")
    os.makedirs(out_dir, exist_ok=True)
    json.dump(res, open(os.path.join(out_dir, "diff.json"), "w"), ensure_ascii=False, indent=1)
    show = lines if a.all else [l for l, r in zip(lines, res) if r["same"] is not True]
    for l in show[: a.limit]:
        print(l)
    if len(show) > a.limit:
        print(f"… {len(show) - a.limit} more — adbm diff --limit {len(show)}")
    singles = [r for r in res if r["missing"]]
    if not has_pairs:
        twins = sum(1 for r in singles if r["same_as_api"])
        n = sum(1 for r in singles if r["missing"] == "before")
        print(f"after only: {n} frames, no before pairs" + (f" ({twins} same as another API)" if twins else "")
              + " · judge them by the checklist")
        stats_add(run, _set={"pairs": 0, "pairs_changed": 0, "frames_after_only": n})
        return 0
    pairs = [r for r in res if not r["missing"]]
    changed = [r for r in pairs if not r["same"]]
    tw = sum(1 for r in changed if r["same_as_api"])
    nb = sum(1 for r in singles if r["missing"] == "before")
    na = len(singles) - nb
    print(f"pairs {len(pairs)}, changed {len(changed)}" + (f" ({tw} same as another API)" if tw else "")
          + f", unchanged {len(pairs) - len(changed)}"
          + (f", no before {nb}" if nb else "") + (f", no after {na}" if na else "")
          + f" · diff images: {rel(out_dir)}/")
    stats_add(run, _set={"pairs": len(pairs), "pairs_changed": len(changed), "frames_after_only": 0})
    return 0


# ---------------------------------------------------------------- record

NO_RUN_HINT = "no run: saved to the project cache, not seen by diff and board — adbm new <slug> first"


def cmd_record(a):
    api, s = pick(a)[0]
    run, version, in_run = frames_home(a)
    d = os.path.join(run, "video", f"api{api}", version)
    os.makedirs(d, exist_ok=True)
    base = os.path.join(d, slugify_name(a.name))
    anim = ("window_animation_scale", "transition_animation_scale", "animator_duration_scale")
    if a.slow:
        was = {k: ashell(s, f"settings get global {k}") for k in anim}
        ashell(s, "; ".join(f"settings put global {k} {a.slow}" for k in anim))
    adb(s, "shell", "rm -f /sdcard/adbm-rec.mp4")
    cmd_rc = None
    try:
        rec = subprocess.Popen([adb_bin(), "-s", s, "shell", "screenrecord", "--time-limit", str(a.seconds),
                                "--bit-rate", "12000000", "/sdcard/adbm-rec.mp4"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(1)
        if a.during:
            with open(base + ".cmd.log", "w") as log:
                cmd_rc = subprocess.call(a.during, stdout=log, stderr=subprocess.STDOUT,
                                         env={**os.environ, "ADBM_NO_STATS": "1"})
        rec.wait()
        time.sleep(1)
        adb(s, "pull", "/sdcard/adbm-rec.mp4", base + ".mp4", timeout=120)
    finally:
        if a.slow:
            if all(re.fullmatch(r"\d+(\.\d+)?|null", v) for v in was.values()):
                ashell(s, "; ".join(f"settings delete global {k}" if v == "null" else f"settings put global {k} {v}"
                                    for k, v in was.items()))
            else:
                prep_device(api, s, **load_pinned(api, s))
    if not os.path.exists(base + ".mp4") or os.path.getsize(base + ".mp4") < 1000:
        die("the video was not recorded (screenrecord may not work on this image)")
    sheet = base + "-sheet.png"
    ff = shutil.which("ffmpeg")
    if ff:
        n = a.frames
        cols = 6
        rows = -(-n // cols)
        fps = max(n / a.seconds, 0.5)
        sh([ff, "-loglevel", "error", "-y", "-i", base + ".mp4", "-vf",
            f"fps={fps:.3f},scale=240:-1,tile={cols}x{rows}", "-frames:v", "1", sheet], timeout=120)
    print(f"{api}: {rel(base + '.mp4')} ({human_size(os.path.getsize(base + '.mp4'))})"
          + (f" · contact sheet {rel(sheet)}" if os.path.exists(sheet) else " · no ffmpeg, no contact sheet")
          + (f" · command returned {cmd_rc}" if cmd_rc else ""))
    if not in_run:
        print(NO_RUN_HINT)
    return 0


# ---------------------------------------------------------------- save-flow

def cmd_save_flow(a):
    p = os.path.join(CACHE, "session.jsonl")
    if not os.path.exists(p):
        die("the journal is empty: no manual actions yet")
    root = project_root()
    ents = [e for e in (json.loads(l) for l in open(p) if l.strip()) if e.get("project", root) == root]
    if not ents:
        die(f"the journal has no actions for project {root}")
    api = a.api and parse_apis(a.api)[0]
    if not api:
        api = ents[-1].get("api")
    ents = [e for e in ents if e.get("api") == api]
    starts = [i for i, e in enumerate(ents) if e["op"] == "launch"]
    if starts:
        ents = ents[starts[-1]:]
    pkg = next((e["package"] for e in ents if e["op"] == "launch"), a.app or "<app package>")
    out = [f"# generated by adbm save-flow from a manual session on API {api} — check the selectors",
           f"appId: {pkg}", "---"]
    n = 0
    for e in ents:
        op = e["op"]
        if op == "launch":
            out += ["- launchApp:", f"    clearState: {'true' if e.get('clear') else 'false'}"]
        elif op == "tap":
            if e.get("text"):
                sel = ["text", e["text"]]
            elif e.get("id"):
                sel = ["id", e["id"]]
            else:
                sel = ["text", e.get("desc", "")]
            val = json.dumps(re.escape(sel[1]) if sel[0] == "text" else sel[1], ensure_ascii=False)
            if e.get("scrolled"):
                out += ["- scrollUntilVisible:", "    element:", f"      {sel[0]}: {val}", "    direction: DOWN"]
            verb = {"long": "longPressOn", "double": "doubleTapOn"}.get(e.get("how") or "", "tapOn")
            out.append(f"- {verb}: {val}" if sel[0] == "text" else f"- {verb}:\n    id: {val}")
        elif op == "tap_xy":
            w, h = e.get("screen") or (1, 1)
            verb = {"long": "longPressOn", "double": "doubleTapOn"}.get(e.get("how") or "", "tapOn")
            out += ["# TODO: tap by coordinates — replace with a selector from adbm ui",
                    f"- {verb}:", f'    point: "{round(100 * e["x"] / w)}%,{round(100 * e["y"] / h)}%"']
        elif op == "clear_field":
            out.append(f"- eraseText: {e.get('n', 50)}")
        elif op == "stopped":
            out.append(f"- stopApp: {e['package']}")
        elif op == "data cleared":
            out.append(f"- clearState: {e['package']}")
        elif op == "uninstalled":
            out.append(f"# TODO: {e['package']} was uninstalled by hand — Maestro has no uninstall step")
        elif op == "type":
            out.append(f'- inputText: {json.dumps(e["text"], ensure_ascii=False)}')
        elif op == "key":
            mk = {"back": "Back", "home": "Home", "enter": "Enter", "del": "Backspace", "escape": "Escape"}
            k = mk.get(e["key"])
            out.append("- back" if e["key"] == "back" else (f"- pressKey: {k}" if k else
                       f"# TODO: key {e['key']} has no Maestro pressKey equivalent"))
        elif op == "swipe" and "," in e["direction"]:
            w, h = e.get("screen") or (1, 1)
            x0, y0, x1, y1 = e["points"]
            out += ["- swipe:", f'    start: "{round(100 * x0 / w)}%,{round(100 * y0 / h)}%"',
                    f'    end: "{round(100 * x1 / w)}%,{round(100 * y1 / h)}%"']
        elif op == "swipe":
            out += ["- swipe:", f'    direction: {e["direction"].upper()}']
        elif op == "open":
            out.append(f'- openLink: {json.dumps(e["uri"], ensure_ascii=False)}')
        elif op in ("wait", "assert"):
            sel = f"      {e.get('by', 'text')}: {json.dumps(e.get('value', ''), ensure_ascii=False)}"
            if op == "assert":
                out += ["- assertVisible:", sel[2:]]
            else:
                out += ["- extendedWaitUntil:", "    notVisible:" if e.get("gone") else "    visible:", sel,
                        f"    timeout: {int(1000 * max(e.get('timeout') or 5, 5))}"]
        elif op == "shot":
            n += 1
            out += ["- waitForAnimationToEnd", f'- takeScreenshot: "{e["name"]}"']
    dest = a.out or os.path.join(project_root(), ".adbm", "flows", slugify(a.slug) + ".yaml")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    if os.path.exists(dest) and not a.force:
        die(f"{rel(dest)} already exists — --force to overwrite")
    open(dest, "w").write("\n".join(out) + "\n")
    print(f"{rel(dest)}: steps {len(ents)}, frames {n} · check: adbm run {rel(dest)} --api {api}")
    return 0


FLOW_TEMPLATE = """appId: {app}
---
- launchApp:
    clearState: true
- extendedWaitUntil:
    visible: "<text of the first screen>"
    timeout: 15000
# steps: selectors from `adbm ui`, waits instead of sleep, see reference/flows.md
- tapOn: "<button>"
- waitForAnimationToEnd
- takeScreenshot: "1-<state>"
"""


def cmd_flow(a):
    dest = os.path.join(project_root(), ".adbm", "flows", slugify(a.slug) + ".yaml")
    if os.path.exists(dest) and not a.force:
        die(f"{rel(dest)} already exists — --force to overwrite")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    app = a.app or default_package() or "<app package>"
    open(dest, "w").write(FLOW_TEMPLATE.format(app=app))
    print(f"{rel(dest)}: template for {app} · fill the steps, then adbm run {rel(dest)} --api 35")
    return 0


def tree_size(p):
    return sum(os.path.getsize(os.path.join(d, f)) for d, _, fs in os.walk(p) for f in fs)


def cmd_clean(a):
    base = runs_dir()
    cur = current_run(create=False, mark=False)
    runs = sorted((p for p in glob.glob(os.path.join(base, "*")) if os.path.isdir(p)), key=os.path.getmtime)
    old = [p for p in runs[:-a.runs] if p != cur] if a.runs > 0 else [p for p in runs if p != cur]
    todo = [(p, tree_size(p)) for p in old]
    if a.cache:
        for pat in ("look", "logs", "shots", "pull", "ui-*.json", "annotate-*.txt", "emu-*.log"):
            todo += [(p, tree_size(p) if os.path.isdir(p) else os.path.getsize(p))
                     for p in glob.glob(os.path.join(CACHE, pat))]
    if not todo:
        print(f"nothing to clean: {len(runs)} runs, keep {a.runs}")
        return 0
    total = sum(n for _, n in todo)
    for p, n in todo[:10]:
        print(("• " if a.yes else "plan: ") + f"{rel(p)} ({human_size(n)})")
    if len(todo) > 10:
        print(f"… {len(todo) - 10} more")
    if not a.yes:
        print(f"this is a plan: {len(todo)} items, {human_size(total)}. To delete: the same command with --yes")
        return 0
    for p, _ in todo:
        shutil.rmtree(p) if os.path.isdir(p) else os.remove(p)
    print(f"deleted {len(todo)} items, {human_size(total)}")
    return 0


# ---------------------------------------------------------------- board and contact sheet

def load_font(size):
    from PIL import ImageFont
    for p in ("/System/Library/Fonts/Supplemental/Arial.ttf", "/System/Library/Fonts/Helvetica.ttc",
              "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans.ttf"):
        if os.path.exists(p):
            try:
                return ImageFont.truetype(p, size)
            except Exception:
                pass
    return ImageFont.load_default()


def collage(frames, keys, apis, out, max_side=2000, verdicts=None):
    """Contact sheet: one block per frame, inside it columns API × "before | after".

    Picks the thumbnail width and the number of block columns so the image
    fits in max_side × max_side: with 20+ images in a request Claude downscales anything over 2000 px.
    """
    Image = pil()
    from PIL import ImageDraw
    gap, hdr = 6, 26
    # frame aspect ratio
    sample = next(p for k in keys for api in frames[k] for p in frames[k][api].values())
    with Image.open(sample) as im:
        ratio = im.height / im.width
    has_before = any("before" in frames[k][a] for k in keys for a in frames[k])
    per = 2 if has_before else 1
    best = None
    for w in range(240, 99, -10):
        th = int(w * ratio)
        bw = len(apis) * (per * w + (per - 1) * 2 + gap) + gap
        bh = hdr + th + gap + (16 if len(apis) > 1 else 0)
        for cols in range(1, len(keys) + 1):
            rows = -(-len(keys) // cols)
            W, H = cols * bw, rows * bh + 30
            if W <= max_side and H <= max_side:
                best = (w, th, bw, bh, cols, rows, W, H)
                break
        if best:
            break
    if not best:
        return None
    w, th, bw, bh, cols, rows, W, H = best
    font, small = load_font(15), load_font(12)
    sheet = Image.new("RGB", (W, H), (40, 40, 44))
    dr = ImageDraw.Draw(sheet)
    title = "before | after" if has_before else "frames"
    dr.text((gap, 7), f"{title} · API {', '.join(map(str, apis))} · frames {len(keys)}", fill=(230, 230, 230), font=font)
    for i, k in enumerate(keys):
        bx, by = (i % cols) * bw, 30 + (i // cols) * bh
        group, name = k
        label = (group + "/" if group else "") + name
        v = (verdicts or {}).get(k)
        color = VERDICT_COLOR.get(v, (230, 230, 230))
        dr.text((bx + gap, by + 5), trunc(label, max(10, bw // 8)) + (f"  {v}" if v else ""), fill=color, font=font)
        for j, api in enumerate(apis):
            x = bx + gap + j * (per * w + (per - 1) * 2 + gap)
            y = by + hdr
            if len(apis) > 1:
                dr.text((x, y), f"API {api}", fill=(170, 170, 170), font=small)
                y += 16
            vs = frames[k].get(api, {})
            for vi, ver in enumerate(VERSIONS[2 - per:]):
                p = vs.get(ver)
                xx = x + vi * (w + 2)
                if p:
                    with Image.open(p) as im:
                        sheet.paste(im.convert("RGB").resize((w, th), Image.LANCZOS), (xx, y))
                else:
                    dr.rectangle((xx, y, xx + w - 1, y + th - 1), fill=(70, 70, 74))
                    dr.text((xx + 8, y + 8), "none", fill=(160, 160, 160), font=small)
    sheet.save(out, optimize=True)
    return W, H


VERDICTS = {"EXPECTED": "expected", "PROBLEM": "problem", "REVIEW": "review"}
VERDICT_RANK = {"expected": 0, "review": 1, "problem": 2}
VERDICT_COLOR = {"expected": (120, 210, 120), "review": (240, 190, 80), "problem": (240, 110, 110)}


def read_verdicts(run):
    """Parse the adbm-eyes section of notes.md.

    Lines `PROBLEM api35/group/name — text` give a verdict per frame and API level
    (no `apiN/` — for every level); a `Summary: …` line gives the overall verdict.
    Returns (worst verdict per (group, name), {(group, name, api): (verdict, text)}, summary, full text).
    """
    worst, per_api, summary = {}, {}, ""
    p = os.path.join(run, "notes.md")
    if not os.path.exists(p):
        return worst, per_api, summary, ""
    text = open(p).read()
    # adbm-eyes appends a section per check: only the latest one counts
    sections = re.split(r"(?m)^#+\s.*adbm-eyes.*$", text)
    latest = sections[-1] if len(sections) > 1 else text
    for line in latest.splitlines():
        sm = re.match(r"\s*\**\s*summary\s*\**\s*:\s*\**\s*(.+)", line, re.I)
        if sm:
            summary = sm.group(1).strip()
            continue
        m = re.match(r"\s*[-*]?\s*(" + "|".join(VERDICTS) + r")\s+(?:api(\d+)/)?(\S+)\s*(?:[—–-]+\s*(.*))?", line, re.I)
        if m:
            v = VERDICTS[m.group(1).upper()]
            path = m.group(3).rstrip(":").rsplit("/", 1)
            key = (path[0], path[1]) if len(path) == 2 else ("", path[0])
            per_api[key + (int(m.group(2)) if m.group(2) else None,)] = (v, (m.group(4) or "").strip())
            # with several API levels a frame keeps its worst verdict
            if VERDICT_RANK[v] >= VERDICT_RANK.get(worst.get(key), -1):
                worst[key] = v
    return worst, per_api, summary, text


def cmd_board(a):
    run = resolve_run(a.run, create=False)
    if not run:
        die("no current run")
    out = os.path.abspath(a.out) if a.out else run
    os.makedirs(out, exist_ok=True)
    frames = scan_run(run)
    if not frames:
        die(f"no api*/… frames in {rel(run)}")
    keys = sorted(frames, key=frame_sort_key)
    apis = sorted({api for k in keys for api in frames[k]})
    verdicts, per_api, verdict_summary, notes = read_verdicts(run)
    diffs = {}
    try:
        for r in json.load(open(os.path.join(run, "diff", "diff.json"))):
            diffs[(r["group"], r["name"], r["api"])] = r
    except Exception:
        pass
    # the contact sheet shows only what the subagent judges: changed pairs or after-only frames
    sheet_keys = keys
    if diffs and not a.all:
        sheet_keys = [k for k in keys if any(r["same"] is not True for kk, r in diffs.items() if kk[:2] == k)]
    items = []
    for k in keys:
        for api in sorted(frames[k]):
            v = frames[k][api]
            d = diffs.get((k[0], k[1], api))
            items.append({
                "group": k[0], "name": k[1], "api": api,
                "before": os.path.relpath(v["before"], out) if "before" in v else None,
                "after": os.path.relpath(v["after"], out) if "after" in v else None,
                "diff": os.path.relpath(os.path.join(run, d["diff"]), out) if d and d.get("diff") else None,
                "pct": d["pct"] if d else None, "same": d["same"] if d else None,
                "same_as_api": d.get("same_as_api") if d else None,
                "crop": os.path.relpath(os.path.join(run, d["crop"]), out) if d and d.get("crop") else None,
                "top": os.path.relpath(os.path.join(run, d["top"]), out) if d and d.get("top") else None,
                "ui": d["ui"] if d else [], "verdict": verdicts.get(k),
                "api_verdict": (per_api.get(k + (api,)) or per_api.get(k + (None,)) or (None, ""))[0],
                "verdict_text": (per_api.get(k + (api,)) or per_api.get(k + (None,)) or (None, ""))[1],
            })
    pairs = len(items)
    summary = []
    for f in glob.glob(os.path.join(out, "00-summary*.png")):
        os.remove(f)
    sheet_apis = sorted({api for k in sheet_keys for api in frames[k]})
    if sheet_keys and sum(len(frames[k]) for k in sheet_keys) <= a.summary_max:
        p = os.path.join(out, "00-summary.png")
        size = collage(frames, sheet_keys, sheet_apis, p, verdicts=verdicts)
        if size:
            summary.append((p, size))
    if sheet_keys and not summary:
        for api in sheet_apis:
            ks = [k for k in sheet_keys if api in frames[k]]
            for page in range(0, len(ks), 24):
                part = ks[page:page + 24]
                suffix = f"-api{api}" + (f"-{page // 24 + 1}" if len(ks) > 24 else "")
                p = os.path.join(out, f"00-summary{suffix}.png")
                size = collage(frames, part, [api], p, verdicts=verdicts)
                if size:
                    summary.append((p, size))
    try:
        stats = json.load(open(os.path.join(run, "stats.json")))
    except Exception:
        stats = {}
    builds = {}
    try:
        builds = json.load(open(os.path.join(run, "builds.json")))
    except Exception:
        pass
    manifest = {
        "run": os.path.basename(run.rstrip("/")), "path": run, "created": dt.datetime.now().isoformat(timespec="seconds"),
        "apis": apis, "groups": sorted({k[0] for k in keys}), "items": items, "notes": notes,
        "stats": stats, "builds": builds,
        "summary": [os.path.relpath(p, out) for p, _ in summary], "verdict_summary": verdict_summary,
        "version": VERSION,
    }
    with open(os.path.join(out, "manifest.js"), "w") as f:
        f.write("window.MANIFEST = " + json.dumps(manifest, ensure_ascii=False) + ";\n")
    shutil.copy(VIEWER, os.path.join(out, "index.html"))
    print(f"board: {rel(os.path.join(out, 'index.html'))} · pairs {pairs} · API {','.join(map(str, apis))}")
    for p, (w, h) in summary:
        tok = -(-w // 28) * -(-h // 28)
        part = f", {len(sheet_keys)} of {len(keys)} frames" if len(sheet_keys) < len(keys) else ""
        print(f"contact sheet: {rel(p)} {w}x{h} (~{tok} tokens{part})")
    if not sheet_keys:
        print("contact sheet: none — every pair is unchanged")
    if notes and not re.search(r"(?m)^#+\s.*adbm-eyes", notes):
        print("warning: notes.md has no adbm-eyes section — the board shows no verdict")
    elif notes:
        judged = [i for i in items if (i["group"], i["name"], i["api"]) in diffs and i["same"] is not True]
        left = [i for i in judged if not i["api_verdict"]]
        if left:
            print(f"warning: {len(left)} changed frames without a verdict, e.g. "
                  + ", ".join(f"api{i['api']}/" + (i["group"] + "/" if i["group"] else "") + i["name"] for i in left[:3]))
    if a.open:
        try:
            subprocess.Popen(["open" if sys.platform == "darwin" else "xdg-open", os.path.join(out, "index.html")],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            print(f"no xdg-open: open {rel(os.path.join(out, 'index.html'))} in a browser")
    return 0


# ---------------------------------------------------------------- new, status

def cmd_new(a):
    p = new_run(a.slug)
    if a.as_:
        open(os.path.join(p, ".as"), "w").write(a.as_)
    print(f"run: {rel(p)}")
    return 0


def load_stats(folder):
    try:
        return json.load(open(os.path.join(folder, "stats.json")))
    except Exception:
        return {}


def context_summary(st):
    """Estimate of what adbm put into the agent context: text ~4 characters per token, images by size.

    `saved` assumes every `ui` and `tap` would otherwise be a full screenshot and every `look` image
    a full one too. Calls per command are counted since 0.2.1: in older stats `calls` is partial or None.
    """
    chars = st.get("chars_by_command") or {}
    calls = st.get("calls_by_command") or {}
    commands = st.get("commands", 0)
    complete = bool(calls) and sum(calls.values()) == commands
    by_command = {k: {"calls": calls.get(k) if complete else None, "tokens": v // 4}
                  for k, v in sorted(chars.items(), key=lambda kv: -kv[1])}
    text, images = st.get("context_chars", 0) // 4, st.get("context_image_tokens", 0)
    screens = sum(calls.get(k, 0) for k in SCREEN_COMMANDS)
    saved = None
    if calls:
        saved = (screens * SCREEN_TOKENS - sum(chars.get(k, 0) for k in SCREEN_COMMANDS) // 4
                 + st.get("context_images", 0) * SCREEN_TOKENS - images)
    return {
        "tokens": text + images, "text_tokens": text, "calls": commands,
        "images": st.get("context_images", 0), "image_tokens": images,
        "thumbs": st.get("thumb_images", 0), "thumb_tokens": st.get("thumb_image_tokens", 0),
        "screens": screens, "saved": saved, "calls_complete": complete, "by_command": by_command,
    }


def run_span(run):
    """Start from the folder name, end from the last stats.json write: '2026-10-16 15:56 → 16:20'."""
    try:
        start = dt.datetime.strptime(os.path.basename(run.rstrip("/"))[:15], "%Y%m%d-%H%M%S")
    except ValueError:
        return None
    p = os.path.join(run, "stats.json")
    end = dt.datetime.fromtimestamp(os.path.getmtime(p)) if os.path.exists(p) else None
    s = start.strftime("%Y-%m-%d %H:%M")
    if end and end.strftime("%Y%m%d%H%M") != start.strftime("%Y%m%d%H%M"):
        s += " → " + end.strftime("%H:%M" if end.date() == start.date() else "%Y-%m-%d %H:%M")
    return s


def project_runs():
    base = runs_dir()
    if not os.path.isdir(base):
        return []
    return sorted(os.path.join(base, n) for n in os.listdir(base)
                  if re.match(r"\d{8}-\d{6}-", n) and os.path.isdir(os.path.join(base, n)))


def project_summary():
    """Rows (name, folder, summary) for every run of the project and "outside runs", plus a total."""
    rows = [(os.path.basename(r), r, context_summary(load_stats(r))) for r in project_runs()]
    outside = load_stats(project_cache())
    if outside:
        rows.append(("outside runs", None, context_summary(outside)))
    total = {k: sum(r[2][k] for r in rows) for k in ("tokens", "calls", "images", "image_tokens", "screens")}
    saved = [r[2]["saved"] for r in rows if r[2]["saved"] is not None]
    total["saved"] = sum(saved) if saved else None
    total["calls_complete"] = all(r[2]["calls_complete"] for r in rows if r[2]["saved"] is not None)
    return {"project": project_root(), "runs": len(project_runs()), "rows": rows, "total": total}


def num(n):
    return "—" if n is None else f"{n:,}"


def saved_cell(saved, complete):
    return num(saved) if saved is None or complete else "≥" + num(saved)


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "s")


def find_run(name):
    """A run of the project by full name, slug or part of the name; the latest of several matches."""
    runs = project_runs()
    for test in (lambda n: n == name, lambda n: n[16:] == name, lambda n: name in n):
        hit = [r for r in runs if test(os.path.basename(r))]
        if hit:
            return hit[-1]
    return None


def print_project(proj, cur):
    print(f"project  {proj['project']} · {plural(proj['runs'], 'run')}")
    if not proj["rows"]:
        print("nothing counted yet — adbm new <slug>")
        return
    names = [("* " if path and cur and os.path.samefile(path, cur) else "  ") + name
             for name, path, _ in proj["rows"]]
    w = max(len(n) for n in names + ["  total"])
    print()
    print(f"{'  run':<{w}}  {'when':<16}  {'calls':>6}  {'tokens':>8}  {'images':>6}  {'saved':>9}")
    for n, (_, path, s) in zip(names, proj["rows"]):
        when = (run_span(path) or "")[:16] if path else ""
        print(f"{n:<{w}}  {when:<16}  {s['calls']:>6}  {num(s['tokens']):>8}  {s['images']:>6}  {saved_cell(s['saved'], s['calls_complete']):>9}")
    t = proj["total"]
    print(f"{'  total':<{w}}  {'':<16}  {t['calls']:>6}  {num(t['tokens']):>8}  {t['images']:>6}  {saved_cell(t['saved'], t['calls_complete']):>9}")
    print()
    print("tokens: what adbm put into the agent context · saved: each ui/tap and look image against a 1080×2400")
    print(f"screenshot (~{SCREEN_TOKENS:,} tokens), rough estimate · * the current run · —, ≥ calls not counted before adbm 0.2.1")
    print("one run in detail: adbm status <run> — the full name, the slug or a part of it")


def print_run(run, a, proj):
    frames = scan_run(run)
    st = load_stats(run)
    s = context_summary(st)
    span = run_span(run)
    print(f"run      {os.path.basename(run.rstrip('/'))} · build {default_as(run, a)}" + (f" · {span}" if span else ""))
    n_frames = sum(len(v) for k in frames for v in frames[k].values())
    n_pairs = sum(1 for k in frames for v in frames[k].values() if len(v) == 2)
    line = f"frames   {n_frames} · pairs {n_pairs}"
    if "pairs_changed" in st:
        line += f" · changed {st['pairs_changed']}"
    print(line)
    print()
    print(f"into agent context ≈ {num(s['tokens'])} tokens")
    print(f"  text      ≈ {num(s['text_tokens']):>7}   {s['calls']} calls")
    print(f"  images    ≈ {num(s['image_tokens']):>7}   {s['images']} (look, crop, annotate)")
    if s["thumbs"]:
        print(f"  subagent  ≈ {num(s['thumb_tokens']):>7}   {s['thumbs']} thumbs, not in the main context")
    if s["by_command"]:
        w = max(7, *(len(k) for k in s["by_command"]))
        print()
        print(f"{'command':<{w}}  {'calls':>5}  {'tokens':>7}  {'per call':>8}")
        for k, c in s["by_command"].items():
            per = c["tokens"] // c["calls"] if c["calls"] else None
            print(f"{k:<{w}}  {num(c['calls']):>5}  {num(c['tokens']):>7}  {num(per):>8}")
        if not s["calls_complete"]:
            print("calls per command: not counted for the whole run (counted since adbm 0.2.1)")
    print()
    if s["saved"] is not None:
        sign = "≈" if s["calls_complete"] else "≥"
        print(f"saved    {sign} {num(s['saved'])} tokens · rough estimate")
        print(f"         {s['screens']} ui/tap and {s['images']} look instead of 1080×2400 screenshots "
              f"(~{SCREEN_TOKENS:,} tokens each)")
    print("not counted: Read of files, build logs, the agent's own text — tools/measure-session.py")
    print(f"project  {plural(proj['runs'], 'run')} · ≈ {num(proj['total']['tokens'])} tokens"
          + (f", saved {saved_cell(proj['total']['saved'], proj['total']['calls_complete'])}" if proj["total"]["saved"] is not None else "")
          + " · adbm status")


def cmd_status(a):
    """Without a run: every run of the project and a total. With a run: that run in detail."""
    proj = project_summary()
    cur = current_run(create=False, mark=False)
    run = None
    if a.run:
        run = find_run(a.run)
        if not run:
            names = ", ".join(os.path.basename(r) for r in project_runs()[-5:]) or "none"
            die(f"no run '{a.run}' in {runs_dir()} · latest: {names}")
    if a.json:
        out = {"project": proj["project"], "runs": proj["runs"], "total": proj["total"],
               "by_run": {name: s for name, _, s in proj["rows"]},
               "current": os.path.basename(cur) if cur else None}
        if run:
            out = {"run": os.path.basename(run), "path": run, "as": default_as(run, a), "span": run_span(run),
                   **context_summary(load_stats(run))}
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return 0
    if run:
        print_run(run, a, proj)
    else:
        print_project(proj, cur)
    return 0


